# ASTRO BOT Rescue Mission (EU; the US release, CUSA12431, links here). Astro runs 3.0 world
# units a second (1 m = 3 units): 0.9 m per unit of the camera's tuning. The picture is
# enlarged behind Astro to the camera's own field of view (the headset eye's is wider); menus
# keep the game's own wide view.
SHADPS4_VR_FLAT_SCALE=0.9
SHADPS4_VR_FLAT_ZOOM=1.2
# Rooms loaded over another, which do not count as leaving it.
SHADPS4_VR_FLAT_OVERLAY_ROOMS=orb,pause_menu,intro_animation,final_level_discovery_animation,calibration,outro_animation,no_interactive_credit
# The bosses' levels are built round the player's seat, the boss ahead of it: behind Astro the
# camera faces the way the seat does there and stands further out, as the 2024 game's boss
# camera holds its view on the boss.
SHADPS4_VR_FLAT_ARENA_ROOMS=rope_boss_test_01,water_boss_final,bird_boss_test_01,spider_boss_test_01,shark_boss_01,final_boss,challenge_boss_gorilla,challenge_boss_octopus,challenge_boss_bird,challenge_boss_spider,challenge_boss_shark,challenge_boss_final
# Over the fade to black when Astro falls to his end (as the 2024 game shows its logo): the
# game's own icon of a bot not yet rescued, made white from its shape.
SHADPS4_VR_FLAT_FADE_PICTURE_FROM=data/multi_platformer/ui/gfx/mup_ui_bot_icon_3.gnf
# Experimental: gadgets aim where the camera looks, turned on by the controller's own motion
# (its gyro) since the view was last moved with the right stick, as the 2024 game's gadgets do.
SHADPS4_VR_FLAT_GYRO_AIM=1
