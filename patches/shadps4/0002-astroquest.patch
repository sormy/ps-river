+constexpr u32 SubmixerSetup = 0x20000000;
+constexpr u32 SubmixerSetEnvelope = 0x20000001;
+constexpr u32 SubmixerSetCompressor = 0x20000002;
+constexpr u32 SubmixerSetDistortion = 0x20000003;
