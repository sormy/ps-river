+    bool block_started{};
+    u32 byte_position{};
+    u32 skip_left{};
+    u32 samples_left{};
+    u32 repeats_done{};
+    std::vector<float> fifo;
+    size_t fifo_read{};
+
+    float pitch{1.0f};
+    double fraction{};
+    std::array<std::array<float, 4>, MaxChannels> history{};
+    bool source_ended{};
+
+    Envelope envelope;
+
+    u64 decoded_samples{};
