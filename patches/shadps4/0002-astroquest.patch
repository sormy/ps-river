+template <typename T>
+T* Lookup(Registry& registry, OrbisNgs2Handle handle, HandleType type) {
+    const auto it = registry.handles.find(handle);
+    if (it == registry.handles.end() || it->second != type) {
+        return nullptr;
+    }
+    return reinterpret_cast<T*>(handle);
