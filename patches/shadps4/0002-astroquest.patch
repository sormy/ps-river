+TEST(GeometrySpecialization, EquivalentLayoutsMatchIncludingZeroInvocations) {
+    GeometryRuntimeInfo info{};
+    EXPECT_EQ(info, info);
+    info.num_invocations = 2;
+    EXPECT_EQ(info, info);
+}
