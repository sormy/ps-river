+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace Core::Vr {
+
+/// When only one eye's picture is shown (flat play), the other eye need not be drawn. Titles
+/// draw the eyes one after the other, so once the shown eye's picture has been drawn, what
+/// else is drawn before the frame is handed over is the other eye's. Used on the GPU thread.
+class UnseenEye {
+public:
+    /// A frame was handed over, the shown eye's picture at `shown` (titles cycle through a few).
+    void HandedOver(std::uintptr_t shown) {
+        if (std::ranges::find(pictures, shown) == pictures.end()) {
+            pictures[next] = shown;
+            next = (next + 1) % pictures.size();
+        }
+        shown_drawn = false;
+    }
+
+    /// Whether a draw into `target` (0: no colour target) is left out.
+    bool LeaveOut(std::uintptr_t target) {
+        if (target != 0 && std::ranges::find(pictures, target) != pictures.end()) {
+            shown_drawn = true;
+            return false;
+        }
+        return shown_drawn;
+    }
+
+private:
+    static constexpr std::size_t Remembered = 4;
+    std::array<std::uintptr_t, Remembered> pictures{};
+    std::size_t next{};
+    bool shown_drawn{};
+};
+
+} // namespace Core::Vr
