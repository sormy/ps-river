diff --git a/tools/tests/unseen_eye_test.cpp b/tools/tests/unseen_eye_test.cpp
new file mode 100644
index 0000000..58d1981
--- /dev/null
+++ b/tools/tests/unseen_eye_test.cpp
@@ -0,0 +1,59 @@
+// Tests for Core::Vr::UnseenEye: what is drawn after the shown eye's picture, until the frame
+// is handed over, is left out.
+#include <cstdio>
+#include <cstdlib>
+#include "core/vr/unseen_eye.h"
+
+namespace {
+
+int failures = 0;
+
+void Check(bool ok, const char* what) {
+    std::printf("%s %s\n", ok ? "ok   " : "FAIL ", what);
+    failures += ok ? 0 : 1;
+}
+
+constexpr std::uintptr_t Shadow = 0x1000;
+constexpr std::uintptr_t Scene = 0x2000;
+constexpr std::uintptr_t LeftPicture = 0x3000;
+constexpr std::uintptr_t NextLeftPicture = 0x4000;
+constexpr std::uintptr_t DepthOnly = 0;
+
+void BeforeAnyFrame() {
+    Core::Vr::UnseenEye eye;
+    Check(!eye.LeaveOut(Scene) && !eye.LeaveOut(DepthOnly), "nothing is left out before a frame was handed over");
+}
+
+void OneFrame() {
+    Core::Vr::UnseenEye eye;
+    eye.HandedOver(LeftPicture);
+    Check(!eye.LeaveOut(Shadow) && !eye.LeaveOut(DepthOnly) && !eye.LeaveOut(Scene),
+          "the shared shadow and the shown eye are drawn");
+    Check(!eye.LeaveOut(LeftPicture) && !eye.LeaveOut(LeftPicture), "and so is the shown eye's picture, every draw of it");
+    Check(eye.LeaveOut(DepthOnly) && eye.LeaveOut(Scene), "after it, the other eye is left out, depth included");
+    eye.HandedOver(LeftPicture);
+    Check(!eye.LeaveOut(Shadow), "the next frame is drawn again");
+}
+
+void CycledPictures() {
+    Core::Vr::UnseenEye eye;
+    eye.HandedOver(LeftPicture);
+    eye.HandedOver(NextLeftPicture);
+    eye.LeaveOut(Scene);
+    eye.LeaveOut(LeftPicture);
+    Check(eye.LeaveOut(Scene), "every picture the shown eye cycles through counts");
+}
+
+} // namespace
+
+int main() {
+    BeforeAnyFrame();
+    OneFrame();
+    CycledPictures();
+    if (failures != 0) {
+        std::printf("%d failed\n", failures);
+        return EXIT_FAILURE;
+    }
+    std::printf("all passed\n");
+    return EXIT_SUCCESS;
+}
