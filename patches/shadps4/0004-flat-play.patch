diff --git a/src/core/vr/flat_mode.h b/src/core/vr/flat_mode.h
new file mode 100644
index 0000000..938a553
--- /dev/null
+++ b/src/core/vr/flat_mode.h
@@ -0,0 +1,300 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cstdlib>
+#include <functional>
+#include <mutex>
+#include <optional>
+#include <sstream>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "core/vr/vr_runtime.h"
+#include "input/flat_camera.h"
+
+namespace Core::Vr {
+
+/// SHADPS4_VR_FLAT=1: a title made for a headset, played on a flat screen. No headset of the
+/// machine's own is looked for, the window shows one eye filling it, and the head the title is
+/// still given is a flat game's camera (Input::FlatCamera): mounted behind what the title says
+/// to follow (FlatFocus) and swung round it with the right stick, or at the player's seat when
+/// there is nothing to follow; R3 headbutts.
+inline bool FlatMode() {
+    static const bool flat = [] {
+        const char* value = std::getenv("SHADPS4_VR_FLAT");
+        return value != nullptr && value[0] == '1';
+    }();
+    return flat;
+}
+
+/// SHADPS4_VR_FLAT_MONO=1: a title that can draw one picture instead of a headset's two (known
+/// title code switches it) does so. Off by default: such a picture is the title's own display,
+/// with a camera of its own in place of flat play's (Rescue Mission's, at 1920x1080).
+inline bool FlatMono() {
+    static const bool mono = [] {
+        const char* value = std::getenv("SHADPS4_VR_FLAT_MONO");
+        return value != nullptr && value[0] == '1';
+    }();
+    return mono;
+}
+
+/// SHADPS4_VR_FLAT_GYRO_AIM=1 (experimental): gadgets aim where the camera looks, turned on by
+/// the controller's own motion since the view was last moved with the stick.
+inline bool FlatGyroAim() {
+    static const bool gyro = [] {
+        const char* value = std::getenv("SHADPS4_VR_FLAT_GYRO_AIM");
+        return FlatMode() && value != nullptr && value[0] == '1';
+    }();
+    return gyro;
+}
+
+/// SHADPS4_VR_FLAT_FOLLOW=0: the camera stays at the player's seat instead of being mounted
+/// behind what the title says to follow (FlatFocus).
+inline bool FlatFollow() {
+    static const bool follow = [] {
+        const char* value = std::getenv("SHADPS4_VR_FLAT_FOLLOW");
+        return value == nullptr || value[0] != '0';
+    }();
+    return follow;
+}
+
+/// The camera behind the hero, from SHADPS4_VR_FLAT_SCALE (metres in a unit of its tuning: the
+/// title's hero size against Input::FlatCamera::Settings' hero), _PITCH (degrees it rests at,
+/// looking down on the hero), _SWING (degrees a second at full stick), _AUTO_TURN (degrees a
+/// second at most it turns behind a hero running across the view, 0 for not at all), _ZOOM
+/// (how much the picture is enlarged at the widest view behind the hero; menus and scenes stay
+/// as drawn) and _OPEN_EXTRA (units further out in the open; 0: no rays to gauge it either);
+/// what is not set keeps Input::FlatCamera::Settings' own.
+inline Input::FlatCamera::Settings FlatCameraSettings() {
+    Input::FlatCamera::Settings settings;
+    const auto read = [](const char* name, float& value, float scale = 1.0f) {
+        if (const char* text = std::getenv(name); text != nullptr && text[0] != '\0') {
+            value = std::strtof(text, nullptr) * scale;
+        }
+    };
+    constexpr float Radians = Input::FlatCamera::Degrees;
+    read("SHADPS4_VR_FLAT_SCALE", settings.scale);
+    read("SHADPS4_VR_FLAT_PITCH", settings.rest_pitch, Radians);
+    read("SHADPS4_VR_FLAT_SWING", settings.yaw_speed, Radians);
+    read("SHADPS4_VR_FLAT_AUTO_TURN", settings.turn_by_move, Radians);
+    read("SHADPS4_VR_FLAT_ZOOM", settings.zoom);
+    read("SHADPS4_VR_FLAT_OPEN_EXTRA", settings.open_radius_extra);
+    return settings;
+}
+
+/// Menus seen from the player's seat: SHADPS4_VR_FLAT_MENU_ROOMS (rooms, comma separated, whose
+/// view does not turn freely: the title says which room it is in, NoteFlatRoom),
+/// SHADPS4_VR_FLAT_MENU_STEPS (where in those rooms left and right step the view between:
+/// headings in degrees, to the left positive, each with a pitch up after a colon if not level;
+/// with none it faces ahead) and
+/// SHADPS4_VR_FLAT_OVERLAY_ROOMS (rooms loaded over another, which do not change the room).
+/// Also SHADPS4_VR_FLAT_ARENA_ROOMS: rooms built round the seat (a boss's), where the camera
+/// behind the hero faces the way the seat does and stands further out.
+struct FlatMenu {
+    std::vector<std::string> rooms;
+    std::vector<Input::MenuStep> steps;
+    std::vector<std::string> overlays;
+    std::vector<std::string> arenas;
+};
+
+inline FlatMenu FlatMenuSettings() {
+    FlatMenu menu;
+    const auto items = [](const char* name) {
+        std::vector<std::string> found;
+        if (const char* text = std::getenv(name); text != nullptr) {
+            std::stringstream list{text};
+            for (std::string item; std::getline(list, item, ',');) {
+                if (!item.empty()) {
+                    found.push_back(item);
+                }
+            }
+        }
+        return found;
+    };
+    menu.rooms = items("SHADPS4_VR_FLAT_MENU_ROOMS");
+    constexpr float Radians = Input::FlatCamera::Degrees;
+    for (const std::string& step : items("SHADPS4_VR_FLAT_MENU_STEPS")) {
+        char* rest = nullptr;
+        const float yaw = std::strtof(step.c_str(), &rest) * Radians;
+        const float pitch = *rest == ':' ? std::strtof(rest + 1, nullptr) * Radians : 0.0f;
+        menu.steps.push_back({yaw, pitch});
+    }
+    std::sort(menu.steps.begin(), menu.steps.end(),
+              [](const Input::MenuStep& a, const Input::MenuStep& b) { return a.yaw < b.yaw; });
+    menu.overlays = items("SHADPS4_VR_FLAT_OVERLAY_ROOMS");
+    menu.arenas = items("SHADPS4_VR_FLAT_ARENA_ROOMS");
+    return menu;
+}
+
+/// What a title says flat play is to follow, in its own world: where the player's head is
+/// there, which way it faces (its heading is what counts), where the thing to follow is, how
+/// many of the world's units make a metre of the head's tracking space, what the hero waits in
+/// the controller to be shot at, if it does, and where the controller is, if it is there.
+struct FlatFocus {
+    Vec3 head;
+    Vec3 head_forward;
+    Vec3 target;
+    float units_per_metre{1.0f};
+    std::optional<Vec3> shot_target;
+    std::optional<Vec3> controller;
+};
+
+using FlatFocusSource = std::function<std::optional<FlatFocus>()>;
+
+/// A sphere swept through a title's world from `from` to `to` (its own units): what flat play's
+/// camera asks the title's physics, to keep in front of the level's walls.
+struct FlatCast {
+    Vec3 from;
+    Vec3 to;
+    float radius{};
+};
+
+/// How far along a cast the sphere first touches the level: 0 at `from`, 1 for not at all.
+using FlatCaster = std::function<float(const FlatCast&)>;
+
+/// Which menu screen a title shows, as the title itself knows it.
+enum class FlatMenuView {
+    Title,  ///< before the menu exists (a title screen in the menu's room)
+    Map,    ///< the choice of worlds (the d-pad and the left stick step between them)
+    Levels, ///< a chosen world's levels (the camera stays on it; the d-pad acts as the stick)
+    Paused, ///< the pause menu, in any room (the view faces ahead from the seat)
+};
+
+namespace Detail {
+inline std::atomic<float> picture_zoom{1.0f};
+inline std::atomic<float> picture_dim{0.0f};
+inline std::atomic<float> pad_aim_yaw{0.0f};
+inline std::atomic<float> pad_aim_pitch{0.0f};
+inline std::atomic<bool> pad_aimed{false};
+inline std::atomic<bool> gyro_recentre{true};
+
+inline std::mutex flat_focus_mutex;
+inline FlatFocusSource flat_focus_source;
+inline std::function<std::optional<FlatMenuView>()> flat_menu_view;
+inline std::mutex flat_cast_mutex;
+inline std::vector<FlatCast> flat_casts;
+inline std::vector<float> flat_cast_results;
+inline std::mutex flat_room_mutex;
+inline std::string flat_room;
+} // namespace Detail
+
+/// For code that knows a title: the room (level, menu) it has loaded last.
+inline void NoteFlatRoom(std::string room) {
+    static const FlatMenu menu = FlatMenuSettings();
+    if (std::find(menu.overlays.begin(), menu.overlays.end(), room) != menu.overlays.end()) {
+        return;
+    }
+    std::scoped_lock lock{Detail::flat_room_mutex};
+    Detail::flat_room = std::move(room);
+}
+
+inline std::string FlatRoom() {
+    std::scoped_lock lock{Detail::flat_room_mutex};
+    return Detail::flat_room;
+}
+
+/// For the camera (the controller's thread): the casts to run when the title's physics next can.
+inline void RequestFlatCasts(std::vector<FlatCast> casts) {
+    std::scoped_lock lock{Detail::flat_cast_mutex};
+    Detail::flat_casts = std::move(casts);
+}
+
+/// For the camera: what the casts last run found, in the order they were asked for (a frame
+/// late); empty before any has run.
+inline std::vector<float> FlatCastResults() {
+    std::scoped_lock lock{Detail::flat_cast_mutex};
+    return Detail::flat_cast_results;
+}
+
+/// For code that knows a title, on the title's own thread when its physics stand still between
+/// steps: runs the casts asked for.
+inline void RunFlatCasts(const FlatCaster& cast) {
+    std::vector<FlatCast> casts;
+    {
+        std::scoped_lock lock{Detail::flat_cast_mutex};
+        casts = Detail::flat_casts;
+    }
+    std::vector<float> results;
+    results.reserve(casts.size());
+    for (const FlatCast& c : casts) {
+        results.push_back(cast(c));
+    }
+    std::scoped_lock lock{Detail::flat_cast_mutex};
+    Detail::flat_cast_results = std::move(results);
+}
+
+/// For code that knows a title: which screen its menu room shows (nothing: not known).
+inline void SetFlatMenuView(std::function<std::optional<FlatMenuView>()> view) {
+    std::scoped_lock lock{Detail::flat_focus_mutex};
+    Detail::flat_menu_view = std::move(view);
+}
+
+inline std::optional<FlatMenuView> ReadFlatMenuView() {
+    std::function<std::optional<FlatMenuView>()> view;
+    {
+        std::scoped_lock lock{Detail::flat_focus_mutex};
+        view = Detail::flat_menu_view;
+    }
+    return view ? view() : std::nullopt;
+}
+
+/// For code that knows a title: what its flat play follows. Asked from the controller's thread.
+inline void SetFlatFocusSource(FlatFocusSource source) {
+    std::scoped_lock lock{Detail::flat_focus_mutex};
+    Detail::flat_focus_source = std::move(source);
+}
+
+/// How much the picture shown is to be enlarged around its middle.
+inline void NotePictureZoom(float zoom) {
+    Detail::picture_zoom.store(zoom, std::memory_order_relaxed);
+}
+
+/// Where flat play has the controller point when nothing tracks it (a title made for a headset
+/// aims gadgets with it): where the camera looks.
+inline void NotePadAim(float yaw, float pitch) {
+    Detail::pad_aim_yaw.store(yaw, std::memory_order_relaxed);
+    Detail::pad_aim_pitch.store(pitch, std::memory_order_relaxed);
+    Detail::pad_aimed.store(true, std::memory_order_release);
+}
+
+/// The controller's attitude now is where its motion aims from (the view was moved).
+inline void RecentrePadGyro() {
+    Detail::gyro_recentre.store(true, std::memory_order_relaxed);
+}
+
+inline bool TakePadGyroRecentre() {
+    return Detail::gyro_recentre.exchange(false, std::memory_order_relaxed);
+}
+
+inline std::optional<std::pair<float, float>> PadAim() {
+    if (!Detail::pad_aimed.load(std::memory_order_acquire)) {
+        return std::nullopt;
+    }
+    return std::pair{Detail::pad_aim_yaw.load(std::memory_order_relaxed),
+                     Detail::pad_aim_pitch.load(std::memory_order_relaxed)};
+}
+
+inline float PictureZoom() {
+    return Detail::picture_zoom.load(std::memory_order_relaxed);
+}
+
+/// How far the picture shown is faded to black (0 to 1).
+inline void NotePictureDim(float dim) {
+    Detail::picture_dim.store(dim, std::memory_order_relaxed);
+}
+
+inline float PictureDim() {
+    return Detail::picture_dim.load(std::memory_order_relaxed);
+}
+
+inline std::optional<FlatFocus> ReadFlatFocus() {
+    std::scoped_lock lock{Detail::flat_focus_mutex};
+    return Detail::flat_focus_source ? Detail::flat_focus_source() : std::nullopt;
+}
+
+} // namespace Core::Vr
