+/// The player's model (a base below the head that follows it a little, a neck up to the head,
+/// and a cape that collides) is drawn round where the head is. Played flat, the head is the
+/// camera behind the hero: the model fills the view, the neck stretches from near the seat to
+/// the camera across the level and the hero runs into it and the cape. Parts of it keep a size
+/// whatever its scale: it is shrunk, its base made to follow the head all the way, and the
+/// whole of it drawn far below the head, under the level.
+void HidePlayerModel() {
+    const Build* const build = known_build.load(std::memory_order_acquire);
+    if (build == nullptr) {
+        return;
+    }
+    constexpr float Hidden = 0.001f;
+    constexpr float Whole = 1.0f;
+    constexpr float Unlimited = 1000.0f;
+    // Past the far plane: the pieces the scale leaves (a stretched strip) then never show.
+    constexpr float Buried = -5000.0f;
+    auto* const memory = Core::Memory::Instance();
+    const u64 settings = Read<u64>(known_base + build->player_settings_pointer);
+    if (settings == 0) {
+        return;
