+u8* AllocateModuleCode(const void* module_ptr, u64 size) {
+    PatchModule* const module = GetModule(module_ptr);
+    if (module == nullptr) {
+        return nullptr;
+    }
+    std::scoped_lock lock{module->mutex};
+    auto& gen = module->trampoline_gen;
+    u8* const room = const_cast<u8*>(gen.getCurr());
+    try {
+        for (u64 i = 0; i < size; ++i) {
+            gen.db(0xcc);
+        }
+    } catch (const Xbyak::Error&) {
+        return nullptr;
+    }
+    return room;
+}
