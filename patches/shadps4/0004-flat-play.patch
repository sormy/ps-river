+/// The game's sphere cast's query and answer (its own units).
+struct alignas(16) SphereQuery {
+    std::array<float, 4> from;
+    std::array<float, 4> to;
+    float radius;
+    u32 collides_as;   // what the sphere is, for the bodies' filters
+    u32 collides_with; // what it may touch
+};
+struct alignas(16) SphereHit {
+    u8 hit;
+    std::array<u8, 0x33> unused;
+    float fraction; // along from-to, 1 for none
+    std::array<u8, 0x48> rest;
+};
+static_assert(offsetof(SphereHit, fraction) == 0x34);
+using SphereCast = SphereHit*(PS4_SYSV_ABI*)(SphereHit*, u64 world, const SphereQuery*);
+/// What a body is (self) and accepts (target) decide what touches it: the level's own bodies are
+/// 0x10 and accept all but 0x04000000, the hero accepts all but 0x80000000, the player's head
+/// 0x100000 or 0x200. A cast that is 0x80000000 and touches 0x10 finds the level alone.
+constexpr u32 CastKind = 0x80000000;
+constexpr u32 LevelKind = 0x10;
+
+/// One of flat play's camera casts, through the game's own sphere cast. On the game's thread,
+/// between physics steps.
+u64 HeroWorld();
+
+float CastSphere(const Vr::FlatCast& cast) {
+    const Build* const build = known_build.load(std::memory_order_acquire);
+    if (build == nullptr) {
+        return 1.0f;
+    }
+    const u64 world = HeroWorld();
+    if (world == 0) {
+        return 1.0f;
+    }
+    // The cast scales its query to the library's units itself: it takes the game's, not the
+    // bodies' (which flat play's casts are in).
+    const float scale = Read<float>(Read<u64>(world + Builds::Physics::WorldInner) + Builds::Physics::InnerScale);
+    const SphereQuery query{.from = {cast.from.x / scale, cast.from.y / scale, cast.from.z / scale, 0.0f},
+                            .to = {cast.to.x / scale, cast.to.y / scale, cast.to.z / scale, 0.0f},
+                            .radius = cast.radius / scale,
+                            .collides_as = CastKind,
+                            .collides_with = LevelKind};
+    SphereHit hit{};
+    hit.fraction = 1.0f;
+    reinterpret_cast<SphereCast>(known_base + build->sphere_cast)(&hit, world, &query);
+    return hit.hit != 0 ? std::clamp(hit.fraction, 0.0f, 1.0f) : 1.0f;
+}
+
+void PS4_SYSV_ABI AfterPhysicsStep() {
+    Vr::RunFlatCasts(CastSphere);
+}
+
+/// Has the game's call of its library's physics step go through a trampoline that takes the
+/// step and then runs flat play's camera casts: the moment the game's physics stand still.
+void HookPhysicsStep(VAddr base, const Build& build) {
+    // sub rsp, 0x28; call <step>; mov [rsp], rax; movups [rsp+0x10], xmm0;
+    // mov rax, <AfterPhysicsStep>; call rax; mov rax, [rsp]; movups xmm0, [rsp+0x10];
+    // add rsp, 0x28; ret
+    constexpr std::array<u8, 44> Trampoline{
+        0x48, 0x83, 0xec, 0x28, 0xe8, 0, 0, 0, 0, 0x48, 0x89, 0x04, 0x24, 0x0f, 0x11,
+        0x44, 0x24, 0x10, 0x48, 0xb8, 0, 0, 0, 0, 0, 0, 0, 0, 0xff, 0xd0, 0x48,
+        0x8b, 0x04, 0x24, 0x0f, 0x10, 0x44, 0x24, 0x10, 0x48, 0x83, 0xc4, 0x28, 0xc3};
+    constexpr u64 StepCall = 4;
+    constexpr u64 HostCall = 20;
+    constexpr u64 Reach = 0x20; // bytes after physics_step's start where the call is
+    const VAddr step = base + build.library_step;
+    const VAddr from = base + build.physics_step[0].at;
+    VAddr site = 0;
+    for (VAddr at = from; at < from + Reach; ++at) {
+        const u8 op = Read<u8>(at);
+        if ((op == 0xe8 || op == 0xe9) && at + 5 + Read<s32>(at + 1) == step) {
+            site = at;
+            break;
+        }
+    }
+    if (site == 0) {
+        LOG_WARNING(Core, "Flat play: the title's physics step was not found where expected; the "
+                          "camera keeps no clear of walls");
+        return;
+    }
+    u8* const room = Core::AllocateModuleCode(reinterpret_cast<const void*>(base), Trampoline.size());
+    if (room == nullptr) {
+        LOG_WARNING(Core, "Flat play: no room for a trampoline; the camera keeps no clear of walls");
+        return;
+    }
+    const VAddr trampoline = reinterpret_cast<VAddr>(room);
+    std::memcpy(room, Trampoline.data(), Trampoline.size());
+    Write<s32>(trampoline + StepCall + 1, static_cast<s32>(step - (trampoline + StepCall + 5)));
+    Write<u64>(trampoline + HostCall, reinterpret_cast<u64>(&AfterPhysicsStep));
+    Write<s32>(site + 1, static_cast<s32>(trampoline - (site + 5)));
+    LOG_INFO(Core, "Flat play: the camera's casts run after each physics step ({:#x})", site - base);
+}
