+/// Which menu screen shows: the pause menu, else the world map's, from its menu's own state.
+std::optional<Vr::FlatMenuView> MenuView() {
+    namespace WorldMenu = Builds::WorldMenu;
+    const Build* const build = known_build.load(std::memory_order_acquire);
+    if (build == nullptr) {
+        return std::nullopt;
+    }
+    if (RoomPaused(*build)) {
+        return Vr::FlatMenuView::Paused;
+    }
+    if (build->world_menu_vtable == 0) {
+        return std::nullopt;
+    }
+    const VAddr menu = world_menu.load(std::memory_order_acquire);
+    if (!HasVtable(menu, build->world_menu_vtable, WorldMenu::State + sizeof(u32))) {
+        return Vr::FlatMenuView::Title;
+    }
+    const u32 state = Read<u32>(menu + WorldMenu::State);
+    return state == WorldMenu::FlyingIn || state == WorldMenu::Levels ? Vr::FlatMenuView::Levels
+                                                                      : Vr::FlatMenuView::Map;
+}
+
+/// Has the title's call at `call` to `constructor` also hand each object it constructs to
+/// `note` (for `what`, in the log). Both are module offsets; 0: not known, nothing done.
+void HookConstruction(VAddr base, u64 call, u64 constructor, PS4_SYSV_ABI void (*note)(VAddr),
+                      std::string_view what) {
+    // sub rsp, 0x28; mov [rsp+0x20], rdi; call <constructor>; mov [rsp+0x18], rax;
+    // mov rdi, [rsp+0x20]; mov rax, <NoteWorldMenu>; call rax; mov rax, [rsp+0x18];
+    // add rsp, 0x28; ret
+    constexpr std::array<u8, 46> Trampoline{
+        0x48, 0x83, 0xec, 0x28, 0x48, 0x89, 0x7c, 0x24, 0x20, 0xe8, 0,    0,    0,    0,    0x48, 0x89,
+        0x44, 0x24, 0x18, 0x48, 0x8b, 0x7c, 0x24, 0x20, 0x48, 0xb8, 0,    0,    0,    0,    0,    0,
+        0,    0,    0xff, 0xd0, 0x48, 0x8b, 0x44, 0x24, 0x18, 0x48, 0x83, 0xc4, 0x28, 0xc3};
+    constexpr u64 ConstructorCall = 9;
+    constexpr u64 HostCall = 24;
+    if (call == 0) {
+        return;
+    }
+    const VAddr site = base + call;
+    const VAddr target = base + constructor;
+    if (Read<u8>(site) != 0xe8 || site + 5 + Read<s32>(site + 1) != target) {
+        LOG_WARNING(Core, "Flat play: {} not made where expected ({:#x}); not followed", what, call);
+        return;
+    }
+    u8* const code = Core::AllocateModuleCode(reinterpret_cast<const void*>(base), Trampoline.size());
+    if (code == nullptr) {
+        LOG_WARNING(Core, "Flat play: no room for a trampoline; {} not followed", what);
+        return;
+    }
+    const VAddr trampoline = reinterpret_cast<VAddr>(code);
+    std::memcpy(code, Trampoline.data(), Trampoline.size());
+    Write<s32>(trampoline + ConstructorCall + 1, static_cast<s32>(target - (trampoline + ConstructorCall + 5)));
+    Write<u64>(trampoline + HostCall + 2, reinterpret_cast<u64>(note));
+    Write<s32>(site + 1, static_cast<s32>(trampoline - (site + 5)));
+    LOG_INFO(Core, "Flat play: {} followed ({:#x})", what, call);
+}
+
+bool Mapped(u64 address, u64 size) {
+    return address != 0 && (address & 3) == 0 && Core::Memory::Instance()->IsValidMapping(address, size);
+}
+
+/// The game's current physics world: the one it is busy with, which changes as it steps its
+/// rooms' worlds (a level's, and overlays' such as the pause menu's) one after another.
+u64 CurrentWorld() {
+    const Build* const build = known_build.load(std::memory_order_acquire);
+    if (build == nullptr) {
+        return 0;
+    }
+    const u64 game = Read<u64>(known_base + build->game_pointer);
+    return Mapped(game, Builds::Physics::GameWorld + 8) ? Read<u64>(game + Builds::Physics::GameWorld) : 0;
+}
+
+u64 WorldLibrary(u64 world) {
+    namespace Physics = Builds::Physics;
+    if (!Mapped(world, Physics::WorldInner + 8)) {
+        return 0;
+    }
+    const u64 inner = Read<u64>(world + Physics::WorldInner);
+    return Mapped(inner, Physics::InnerLibrary + 8) ? Read<u64>(inner + Physics::InnerLibrary) : 0;
+}
+
+/// The world the hero was last found in, its body library (to tell it is still that world) and
+/// when (steady clock, ns). In a level its world comes round as the current one many times a
+/// second; once it has not for a while (a menu, another level), it is no longer the hero's.
+std::atomic<u64> hero_world{0};
+std::atomic<u64> hero_library{0};
+std::atomic<s64> hero_world_seen{0};
+constexpr std::chrono::milliseconds HeroWorldFresh{500};
+
+/// The world the hero was found in lately while it still is, else the current one.
+u64 HeroWorld() {
+    const u64 world = hero_world.load(std::memory_order_acquire);
+    const auto seen = std::chrono::steady_clock::time_point{
+        std::chrono::nanoseconds{hero_world_seen.load(std::memory_order_acquire)}};
+    if (world != 0 && std::chrono::steady_clock::now() - seen < HeroWorldFresh &&
+        WorldLibrary(world) == hero_library.load(std::memory_order_acquire)) {
+        return world;
+    }
+    return CurrentWorld();
+}
+
+/// The hero seen from the player's head in one physics world, if it is there.
+std::optional<Vr::FlatFocus> HeroFocusIn(u64 world) {
+    namespace Physics = Builds::Physics;
+    const auto there = [](u64 address, u64 size) { return Mapped(address, size); };
+    if (!there(world, Physics::WorldInner + 8)) {
+        return std::nullopt;
+    }
+    const u64 inner = Read<u64>(world + Physics::WorldInner);
+    if (!there(inner, Physics::InnerScale + 4)) {
+        return std::nullopt;
+    }
+    const u64 library = Read<u64>(inner + Physics::InnerLibrary);
+    if (!there(library, Physics::LibraryBodies + 8)) {
+        return std::nullopt;
+    }
+    const u32 count = Read<u32>(library + Physics::LibraryBodyCount);
+    const u64 bodies = Read<u64>(library + Physics::LibraryBodies);
+    if (count <= HeroBody || !there(bodies, (HeroBody + 1) * Physics::BodySize)) {
+        return std::nullopt;
+    }
+    const auto body = [&](u32 index) { return bodies + u64{index} * Physics::BodySize; };
+    const auto motion = [&](u32 index) { return Read<u8>(body(index) + Physics::BodyMotion); };
+    if (motion(HeadFront) != HeadMotions[0] || motion(HeadMiddle) != HeadMotions[1] ||
+        motion(HeadBack) != HeadMotions[2] || motion(HeroBody) != Physics::MotionActive) {
+        return std::nullopt;
+    }
+    const auto at = [&](u32 index) {
+        const auto p = Read<std::array<float, 3>>(body(index) + Physics::BodyPosition);
+        return Vr::Vec3{p[0], p[1], p[2]};
+    };
+    const float scale = Read<float>(inner + Physics::InnerScale);
+    if (!(scale > 0.0f)) {
+        return std::nullopt;
+    }
+    const Vr::Vec3 hero = at(HeroBody);
+    // While a level starts the hero waits at the world's origin, not yet in play.
+    if (std::hypot(hero.x, hero.y, hero.z) < 0.01f) {
+        return std::nullopt;
+    }
+    const Vr::Vec3 front = at(HeadFront);
+    const Vr::Vec3 back = at(HeadBack);
+    const Vr::Vec3 middle = at(HeadMiddle);
+    const float length = std::hypot(front.x - back.x, front.y - back.y, front.z - back.z) / scale;
+    const float off_middle = std::hypot((front.x + back.x) / 2 - middle.x, (front.y + back.y) / 2 - middle.y,
+                                        (front.z + back.z) / 2 - middle.z) / scale;
+    const float size = length / HeadLength;
+    if (size < HeadSmallest || size > HeadLargest || off_middle > HeadTolerance * size) {
+        return std::nullopt;
+    }
+    const auto apart = [](const Vr::Vec3& a, const Vr::Vec3& b) {
+        return std::hypot(a.x - b.x, a.y - b.y, a.z - b.z);
+    };
+    std::optional<Vr::Vec3> rings;
+    if (count > ControllerBody && there(bodies, u64{count} * Physics::BodySize) &&
+        apart(at(ControllerBody), hero) < InControllerWithin * scale) {
+        const Vr::Vec3 controller = at(ControllerBody);
+        Vr::Vec3 sum{};
+        u32 found = 0;
+        for (u32 i = ControllerBody + 1; i < count; ++i) {
+            if (Read<u32>(body(i) + Physics::BodyKind) == GoalRingsKind && at(i).y > controller.y &&
+                apart(at(i), controller) < RingsWithin * scale) {
+                const Vr::Vec3 p = at(i);
+                sum = {sum.x + p.x, sum.y + p.y, sum.z + p.z};
+                ++found;
+            }
+        }
+        if (found != 0) {
+            rings = Vr::Vec3{sum.x / found, sum.y / found, sum.z / found};
+        }
+    }
