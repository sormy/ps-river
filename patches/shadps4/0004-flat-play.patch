diff --git a/src/input/flat_camera.h b/src/input/flat_camera.h
new file mode 100644
index 0000000..b96dfad
--- /dev/null
+++ b/src/input/flat_camera.h
@@ -0,0 +1,942 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cmath>
+#include <numbers>
+#include <optional>
+#include <span>
+#include <utility>
+#include <vector>
+
+namespace Input {
+
+/// A position in the head's tracking space: metres, +X right, +Y up, -Z ahead of the seat the
+/// title puts the player in. Yaw turns to the left, pitch up.
+struct TrackVec {
+    float x{};
+    float y{};
+    float z{};
+};
+
+inline float Wrap(float angle) {
+    return std::remainder(angle, 2.0f * std::numbers::pi_v<float>);
+}
+
+inline float Blend(float step, float time) {
+    return 1.0f - std::exp(-step / time);
+}
+
+/// Where a title's own world sits in the head's tracking space, worked out from where the
+/// title says the head is in its world and how it faces there, against the pose the head was
+/// given when the title took it: titles answer a frame or two late, so the poses given are
+/// kept a while and the one from then is used. Lightly smoothed after that, so that the title
+/// carrying the player's seat along a level is followed at once.
+class WorldPlacement {
+public:
+    static constexpr float SettleTime = 0.05f;
+    /// How long after a pose is given the title reports the head where it put it.
+    static constexpr double TitleLag = 0.033;
+    static constexpr std::size_t History = 64;
+
+    /// What the head was given at `now`.
+    void NotePose(double now, const TrackVec& pose, float yaw) {
+        given[next] = {now, pose, yaw};
+        next = (next + 1) % History;
+        count = std::min(count + 1, History);
+    }
+
+    /// `head`, `head_forward`: in the world, as the title says now; `units_per_metre`: of it.
+    void Update(double now, const TrackVec& head, const TrackVec& head_forward, float units_per_metre) {
+        const Given then = GivenAt(now - TitleLag);
+        const float step = valid ? static_cast<float>(std::clamp(now - last, 0.0, 0.1)) : 0.0f;
+        last = now;
+        const float yaw = Wrap(std::atan2(-head_forward.x, -head_forward.z) - then.yaw);
+        const float blend = valid ? Blend(step, SettleTime) : 1.0f;
+        turn = Wrap(turn + Wrap(yaw - turn) * blend);
+        scale = units_per_metre;
+        // The world point the tracking space's origin is at.
+        const TrackVec turned = Turn(then.pose, turn);
+        const TrackVec seen{head.x - turned.x * scale, head.y - turned.y * scale, head.z - turned.z * scale};
+        origin.x += (seen.x - origin.x) * blend;
+        origin.y += (seen.y - origin.y) * blend;
+        origin.z += (seen.z - origin.z) * blend;
+        valid = true;
+    }
+
+    /// A point of the world, in the head's tracking space.
+    TrackVec ToTrack(const TrackVec& world) const {
+        return Turn({(world.x - origin.x) / scale, (world.y - origin.y) / scale, (world.z - origin.z) / scale},
+                    -turn);
+    }
+
+    /// A point of the head's tracking space, in the world.
+    TrackVec ToWorld(const TrackVec& track) const {
+        const TrackVec turned = Turn(track, turn);
+        return {origin.x + turned.x * scale, origin.y + turned.y * scale, origin.z + turned.z * scale};
+    }
+
+    /// The world's units in a metre of tracking space.
+    float Scale() const {
+        return scale;
+    }
+
+    bool Valid() const {
+        return valid;
+    }
+
+    void Reset() {
+        valid = false;
+    }
+
+    /// Turns a vector about +Y, to the left for a positive angle.
+    static TrackVec Turn(const TrackVec& v, float angle) {
+        const float c = std::cos(angle);
+        const float s = std::sin(angle);
+        return {v.x * c + v.z * s, v.y, -v.x * s + v.z * c};
+    }
+
+private:
+    struct Given {
+        double time{};
+        TrackVec pose;
+        float yaw{};
+    };
+
+    /// The latest pose given no later than `time`, or the oldest kept.
+    Given GivenAt(double time) const {
+        Given found{};
+        bool any = false;
+        for (std::size_t i = 0; i < count; ++i) {
+            const Given& g = given[(next + History - 1 - i) % History];
+            found = g;
+            any = true;
+            if (g.time <= time) {
+                break;
+            }
+        }
+        return any ? found : Given{};
+    }
+
+    std::array<Given, History> given{};
+    std::size_t next{};
+    std::size_t count{};
+    double last{};
+    float turn{};
+    float scale{1.0f};
+    TrackVec origin;
+    bool valid{};
+};
+
+/// Where a menu's view can look: a heading (to the left positive) and a pitch (up positive).
+struct MenuStep {
+    float yaw{};
+    float pitch{};
+};
+
+/// A menu seen from the seat that is not to be turned freely (the stick is the title's there):
+/// it faces ahead, or one of `steps` (from right to left) that a press left or right moves
+/// between; `home` turns it back to the step straight ahead (where a title brings what is
+/// picked).
+struct SeatMenu {
+    bool fixed{};
+    std::span<const MenuStep> steps;
+    int step{}; // -1 left held, 1 right held, 0 neither
+    bool home{};
+};
+
+/// The head of a title made for a headset, played on a flat screen, as the camera of a flat
+/// platformer (Astro Bot's, docs/camera-port.md). With a hero to follow it orbits a point above
+/// them. The right stick turns it and it stays turned; while the hero runs sideways (the move
+/// stick across) it turns by itself to follow them, so one stick is enough to play; left alone,
+/// its pitch eases back to a resting one as the hero moves on. The higher it looks down from,
+/// the further out it sits and the wider it sees. It follows the ground the hero stands on
+/// rather than their jumps, and walls pull it in at once (casts through the title's physics,
+/// a frame late) and let it out slowly, only while the player plays. All of it is tuned in units
+/// of the hero's size (Settings::scale metres each). With nothing to follow (menus, scenes) it
+/// goes back to the player's seat and the right stick turns the view round freely. A hero has to
+/// be there a moment before it is followed and gone a moment before it is let go, so that a
+/// scene changing over does not move the camera. A held button pushes the head forward: a
+/// headbutt, which a title tells from a nod by its speed.
+class FlatCamera {
+public:
+    using Vec = TrackVec;
+    struct Stick {
+        float x{}; // right positive
+        float y{}; // up positive
+    };
+    using Menu = SeatMenu;
+    struct Head {
+        float yaw{};
+        float pitch{};
+        Vec position;
+        float zoom{1.0f}; // of the picture shown: the title's own field of view is wide
+        float dim{};      // of the picture shown, to black: over a fall to the end
+    };
+    /// A sphere swept through the world, in tracking space; what it finds comes back as how far
+    /// along it first touches something (0 to 1; 1 for nothing).
+    struct Cast {
+        Vec from;
+        Vec to;
+        float radius{};
+    };
+    static constexpr float Degrees = std::numbers::pi_v<float> / 180.0f;
+    /// What can be set per title (Core::Vr::FlatCameraSettings reads it). Lengths are in units
+    /// of `scale` metres, angles in radians, pitch positive looking down on the hero.
+    struct Settings {
+        float scale = 1.0f;
+        float radius_near = 0.4f; // looking along the ground
+        float radius_far = 2.0f;  // looking straight down
+        float fov_near = 60.0f * Degrees;
+        float fov_far = 50.0f * Degrees;
+        /// The point orbited, from the hero: across, up, back (towards the camera).
+        Vec offset_near{0.0f, 0.28f, 0.0f};
+        Vec offset_far{0.0f, 0.5f, 0.0f};
+        float hero_height = 0.25f;
+        float pitch_min = -40.0f * Degrees;
+        float pitch_max = 80.0f * Degrees;
+        float start_pitch = 20.0f * Degrees;
+        float rest_pitch = 20.0f * Degrees;
+        float yaw_speed = 90.0f * Degrees;    // a second at full stick
+        float pitch_speed = 80.0f * Degrees;  // a second at full stick
+        float turn_by_move = 60.0f * Degrees; // a second, running sideways at full stick
+        float zoom = 1.0f; // how much the picture is enlarged at the widest view (1: not)
+        /// In an arena (a room built round the seat: a boss's) the camera faces the way the
+        /// seat does and stands this much further out.
+        float arena_radius_extra = 1.0f;
+        /// In the open (nothing round the hero) the camera stands this much further out; by
+        /// walls, less (the 2024 game's levels let it out by up to this much).
+        float open_radius_extra = 1.0f;
+    };
+    /// How the camera frames the hero at a pitch: metres out, picture enlargement.
+    struct Framing {
+        float share{}; // of the way from the near framing to the far one
+        float radius{};
+        float zoom{1.0f};
+    };
+
+    FlatCamera() = default;
+    explicit FlatCamera(const Settings& settings) : settings{settings} {}
+
+    static constexpr float StickDeadZone = 0.15f;
+    // At the seat: radians a second at full stick, and how far up or down it looks at most.
+    static constexpr float SeatTurnSpeed = 1.8f;
+    static constexpr float SeatTiltSpeed = 1.2f;
+    static constexpr float MaxSeatPitch = 1.2f;
+    static constexpr float ReturnTime = 0.5f;
+    static constexpr float FollowAfter = 0.5f; // seconds a hero is seen before it is followed
+    static constexpr float LeaveAfter = 0.3f;  // seconds it is gone before it is let go
+    static constexpr float MountTime = 0.15f;
+    static constexpr float MountSettleTime = 0.7f; // the move from the seat is eased this long
+    // Behind the hero. A filter is the share kept each sixtieth of a second.
+    static constexpr float LookFilter = 0.86f;
+    static constexpr float MoveFilter = 0.8f;
+    static constexpr float PitchSoftBand = 20.0f * Degrees; // slows the stick near a pitch limit
+    static constexpr float RestAfter = 0.5f;    // seconds without the camera stick
+    static constexpr float RestDuration = 1.5f; // seconds of full move stick to rest the pitch
+    static constexpr float SharePower = 0.9f;
+    static constexpr float FollowXZ = 0.85f;
+    static constexpr float FollowY = 0.95f;
+    static constexpr float FollowFastSpeed = 5.0f; // units a second: the hero followed at once
+    static constexpr float FollowFastPower = 3.0f;
+    static constexpr float CloseIn = 0.85f;     // share pulled in past which height follows sooner
+    static constexpr float NearShare = 0.5f;    // framing share below which height follows sooner
+    static constexpr float HeadPoint = 0.7f;    // of the hero's height: what walls pull towards
+    static constexpr float VelocityTime = 0.1f; // seconds the hero's speed is smoothed over
+    // The ground under the hero, which the camera's height follows instead of jumps.
+    static constexpr float GroundCastLength = 10.0f;
+    static constexpr float GroundCastLift = 0.1f;
+    static constexpr float GroundedGap = 0.1f;
+    static constexpr float GroundRise = 0.92f;
+    static constexpr float FallStart = 0.85f;
+    static constexpr float FallEnd = 0.5f;
+    static constexpr float FallDelay = 0.2f;
+    static constexpr float FallDuration = 0.5f;
+    static constexpr float LostBelow = 0.5f; // seconds to the hero's height with no ground found
+    static constexpr float LostAbove = 10.0f;
+    static constexpr float HeightSpanFar = 3.0f;
+    static constexpr float HeightSpanNear = 0.1f;
+    static constexpr float HeightOffset = 0.35f;
+    static constexpr float LowShare = 0.3f; // pitch share below which height follows the hero
+    // Walls.
+    static constexpr float CastRadius = 0.05f;
+    static constexpr float CastAcross = 8.0f * Degrees; // the four casts' spread, across
+    static constexpr float CastUp = 4.5f * Degrees;     // and up and down
+    static constexpr float OutFilter = 0.92f;
+    static constexpr float HoldIn = 0.1f;    // seconds of play before it lets out
+    static constexpr float EaseOut = 0.1f;   // seconds over which it starts to
+    static constexpr float PlayRise = 0.7f;  // filters of how much is being played
+    static constexpr float PlayFall = 0.93f;
+    /// Nearest a wall pulls it to the point it orbits: closer it would be inside the hero, whom
+    /// a title made for a headset cannot fade out as a flat game does.
+    static constexpr float NearestOut = 0.3f;
+
+    static constexpr float ZoomTime = 0.4f;
+    static constexpr float LeanSpeed = 2.0f;
+    /// A held lean moves the head to the side this far (dodging what a title throws at it).
+    static constexpr float LeanDistance = 0.3f;
+    /// After a shot: slower than this (metres a second) for this long (seconds) is at rest.
+    static constexpr float RestSpeed = 0.2f;
+    /// A target to be shot at swings at least this far (metres); one that does not is not one.
+    static constexpr float SwingAtLeast = 0.5f;
+    /// In an arena: the time to turn to the seat's way.
+    static constexpr float ArenaTurnTime = 1.0f;
+    /// Side-on: beyond this far from the seat (units), running at this speed at least (units a
+    /// second) this many times more across the seat's line than along it, this long (seconds),
+    /// the view turns to the line (settling in about the 2024 game's Duration2D, 2 s: three of
+    /// SideTurnTime); along it this long, it is let go.
+    static constexpr float SideFrom = 1.0f;
+    static constexpr float SideSpeed = 0.3f;
+    static constexpr float SideRatio = 2.0f;
+    static constexpr float SideAfter = 0.5f;
+    static constexpr float SideLeaveAfter = 1.0f;
+    static constexpr float SideTurnTime = 0.67f;
+    /// Units from where it belongs beyond which the camera goes there at once, not eased.
+    static constexpr float SnapBeyond = 3.0f;
+    /// A fall this far below where the hero stood (units) is to the end: the picture fades out
+    /// over FadeInTime, stays dark until DarkAfter past their return and fades back over
+    /// FadeOutTime (seconds).
+    static constexpr float FadeBelow = 8.0f;
+    static constexpr float FadeInTime = 0.4f;
+    static constexpr float DarkAfter = 0.4f;
+    static constexpr float FadeOutTime = 0.5f;
+    /// The extra distance (an arena's, the open's) is eased in and out slowly.
+    static constexpr float RadiusExtraFilter = 0.98f;
+    /// The casts: the ground's first, then the walls behind the camera, then the rays round the
+    /// hero that tell how open it is (this far out, units; below this share free, enclosed).
+    static constexpr std::size_t FirstWallCast = 1;
+    static constexpr std::size_t WallCasts = 4;
+    static constexpr std::size_t FirstOpenCast = FirstWallCast + WallCasts;
+    static constexpr std::size_t OpenCasts = 8;
+    static constexpr float OpenReach = 3.0f;
+    static constexpr float OpenAbove = 1.0f;
+    static constexpr float EnclosedBelow = 0.5f;
+    /// Falling: this far (units) below where the hero last stood, with no floor under them.
+    static constexpr float FallingDrop = 1.0f;
+    static constexpr float FloorNear = 3.0f; // units: a floor further under a falling hero is none
+    static constexpr float FallingSpeed = 5.0f; // units a second down; slower is sinking (water)
+    static constexpr float FallWatchTurnTime = 1.0f;
+    /// Seconds on a floor far below before the hero is taken up there (the end, below, takes
+    /// them back sooner).
+    static constexpr float LandedAfterFall = 1.0f;
+    static constexpr float StillAfterFall = 2.0f;
+    static constexpr float StillWithin = 0.15f; // units
+    static constexpr float RestedAfterShot = 0.5f;
+    /// Longer gaps between updates (a stall) do not count as time to move in.
+    static constexpr double MaxStep = 0.1;
+
+    /// `now` in seconds; the sticks from -1 to 1; `hero` where the hero is in tracking space, if
+    /// there is one to follow; `hits` what the casts asked for last (Casts) found; `shot_at` a
+    /// target the hero waits in the controller to be shot at (a title's catapult), if any;
+    /// `arena` whether the room is built round the seat (a boss's).
+    Head Update(double now, Stick look, Stick move, std::optional<Vec> hero_at,
+                std::span<const float> hits = {}, Menu menu = {}, int lean_held = 0,
+                std::optional<Vec> shot_at = std::nullopt, bool arena = false) {
+        const float step = started ? static_cast<float>(std::clamp(now - last, 0.0, MaxStep)) : 0.0f;
+        started = true;
+        last = now;
+        in_arena = arena;
+        const float open_extra = OpenShare() * settings.open_radius_extra;
+        radius_extra = Keep(radius_extra, std::max(arena ? settings.arena_radius_extra : 0.0f, open_extra),
+                            RadiusExtraFilter, step);
+
+        look = DeadZoned(look);
+        move = DeadZoned(move);
+        if (hero_at) {
+            seen_for += step;
+            gone_for = 0.0f;
+            last_seen = *hero_at;
+        } else {
+            gone_for += step;
+            seen_for = 0.0f;
+        }
+        float zoom = 1.0f;
+        casts.clear();
+        if (menu.fixed) {
+            shot = std::nullopt;
+            InMenu(step, menu);
+        } else if (Shooting(step, hero_at, shot_at)) {
+            AtShot(step);
+        } else if (watching_fall && !hero_at) {
+            // A hero lost at their end (a title may stop saying where they are): held where it is.
+        } else if (mounted ? gone_for < LeaveAfter : seen_for >= FollowAfter) {
+            zoom = Mount(step, look, move, last_seen, hits);
+        } else {
+            Seat(step, look);
+        }
+        head.zoom += (zoom - head.zoom) * Blend(step, ZoomTime);
+        FadeAtTheEnd(step, hero_at.has_value());
+        const float lean_target = menu.fixed ? 0.0f : static_cast<float>(lean_held) * LeanDistance;
+        lean += std::clamp(lean_target - lean, -LeanSpeed * step, LeanSpeed * step);
+        head.position = {mount.x + std::cos(head.yaw) * lean, mount.y, mount.z - std::sin(head.yaw) * lean};
+        return head;
+    }
+
+    const Head& Last() const {
+        return head;
+    }
+
+    /// The casts to run for the next update: the ground under the hero, then the walls behind
+    /// the camera (none at the seat).
+    const std::vector<Cast>& Casts() const {
+        return casts;
+    }
+
+    /// The point a mounted camera orbits.
+    Vec LookPoint() const {
+        return orbited;
+    }
+
+    Framing Frame(float at_pitch) const {
+        const float share = std::pow(
+            std::clamp((at_pitch - settings.pitch_min) / (settings.pitch_max - settings.pitch_min), 0.0f, 1.0f),
+            SharePower);
+        const float fov = Mix(settings.fov_near, settings.fov_far, share);
+        const float widest = std::max(settings.fov_near, settings.fov_far);
+        return {share, (Mix(settings.radius_near, settings.radius_far, share) + radius_extra) * settings.scale,
+                settings.zoom * std::tan(widest / 2) / std::tan(fov / 2)};
+    }
+
+private:
+    static float Mix(float a, float b, float t) {
+        return a + (b - a) * t;
+    }
+
+    static Vec Mix(const Vec& a, const Vec& b, float t) {
+        return {Mix(a.x, b.x, t), Mix(a.y, b.y, t), Mix(a.z, b.z, t)};
+    }
+
+    /// The share kept of `x` for a filter keeping `keep` each sixtieth of a second.
+    static float Keep(float x, float target, float keep, float step) {
+        const float k = std::pow(std::max(keep, 0.0f), 60.0f * step);
+        return k * x + (1.0f - k) * target;
+    }
+
+    static float Ease(float u) {
+        return 0.5f * (1.0f - std::cos(std::numbers::pi_v<float> * std::clamp(u, 0.0f, 1.0f)));
+    }
+
+    static Stick DeadZoned(Stick s) {
+        const float length = std::hypot(s.x, s.y);
+        if (length <= StickDeadZone) {
+            return {};
+        }
+        const float scale = std::min(1.0f, (length - StickDeadZone) / (1.0f - StickDeadZone)) / length;
+        return {s.x * scale, s.y * scale};
+    }
+
+    static void Approach(Vec& from, const Vec& to, float blend) {
+        from.x += (to.x - from.x) * blend;
+        from.y += (to.y - from.y) * blend;
+        from.z += (to.z - from.z) * blend;
+    }
+
+    /// From the point orbited out to the camera, at a yaw and pitch.
+    static Vec Back(float yaw, float pitch) {
+        return {std::sin(yaw) * std::cos(pitch), std::sin(pitch), std::cos(yaw) * std::cos(pitch)};
+    }
+
+    /// Returns the picture's enlargement.
+    float Mount(float step, Stick look, Stick move, const Vec& seen, std::span<const float> hits) {
+        const float unit = settings.scale;
+        if (!mounted) {
+            hero = pivot = seen;
+            velocity = {};
+            yaw = brought_back ? 0.0f : std::atan2(-(seen.x - mount.x), -(seen.z - mount.z));
+            brought_back = false;
+            pitch = settings.start_pitch;
+            ground = seen.y;
+            // Taken up again while seen falling (a title may lose sight of a hero at its end): the
+            // fall is still being watched.
+            if (!watching_fall) {
+                stood = seen.y;
+            }
+            intrusion = played = blocked_for = 0.0f;
+            look_in = {};
+            turn_in = 0.0f;
+            idle_for = 0.0f;
+            resting = false;
+            mounted_for = 0.0f;
+            side_on = side_turned = false;
+            across_for = along_for = 0.0f;
+            radius = Frame(pitch).radius;
+            mounted = true;
+        }
+        mounted_for += step;
+        if (step > 0.0f) {
+            const Vec moved{(seen.x - hero.x) / step, (seen.y - hero.y) / step, (seen.z - hero.z) / step};
+            Approach(velocity, moved, Blend(step, VelocityTime));
+        }
+        hero = seen;
+        ReadOpenness(hits);
+        if (WatchFall(step, hits)) {
+            return head.zoom;
+        }
+
+        Rotate(step, look, move);
+        FollowGround(step, hits);
+
+        const Framing frame = Frame(pitch);
+        if (frame.radius < radius) {
+            intrusion = std::max(0.0f, intrusion - (radius - frame.radius));
+        }
+        radius = frame.radius;
+        Follow(step, frame.share);
+
+        const Vec offset = Mix(Mix(settings.offset_near, settings.offset_far, frame.share),
+                               Vec{0.0f, HeadPoint * settings.hero_height, 0.0f}, intrusion / radius);
+        const float c = std::cos(yaw);
+        const float s = std::sin(yaw);
+        orbited = {pivot.x + (offset.x * c + offset.z * s) * unit, pivot.y + offset.y * unit,
+                   pivot.z + (-offset.x * s + offset.z * c) * unit};
+
+        KeepClear(step, look, move, hits);
+        if (settings.open_radius_extra > 0.0f) {
+            CastOpenness();
+        }
+
+        const Vec back = Back(yaw, pitch);
+        const float out = radius - intrusion;
+        const Vec target{orbited.x + back.x * out, orbited.y + back.y * out, orbited.z + back.z * out};
+        // (Far from where it belongs, as after a hero is brought back, it goes there at once: it
+        // would slide through the level.)
+        if (mounted_for < MountSettleTime &&
+            std::hypot(target.x - mount.x, target.y - mount.y, target.z - mount.z) < SnapBeyond * unit) {
+            Approach(mount, target, Blend(step, MountTime));
+        } else {
+            mount = target;
+        }
+        const Vec to{orbited.x - mount.x, orbited.y - mount.y, orbited.z - mount.z};
+        head.yaw = std::atan2(-to.x, -to.z);
+        head.pitch = std::atan2(to.y, std::hypot(to.x, to.z));
+        look_yaw = head.yaw;
+        look_pitch = head.pitch;
+        return frame.zoom;
+    }
+
+    /// A side-on stretch: the hero running across the line from the player's seat (the tracking
+    /// space's origin; the levels were made to be seen from there) to them, as along a wall or
+    /// round the seat. Held while they stand; let go once they run along the line a while (which
+    /// also starts a new stretch after the player turned the view themselves).
+    void SideOn(float step) {
+        const float unit = settings.scale;
+        const float out = std::hypot(hero.x, hero.z);
+        if (out < SideFrom * unit || std::hypot(velocity.x, velocity.z) < SideSpeed * unit) {
+            return;
+        }
+        const float along = (velocity.x * hero.x + velocity.z * hero.z) / out;
+        const float across = std::abs(velocity.x * hero.z - velocity.z * hero.x) / out;
+        const bool sideways = across > SideRatio * std::abs(along);
+        across_for = sideways ? across_for + step : 0.0f;
+        along_for = sideways ? 0.0f : along_for + step;
+        if (across_for >= SideAfter && !side_turned) {
+            side_on = true;
+        } else if (along_for >= SideLeaveAfter) {
+            side_on = side_turned = false;
+        }
+    }
+
+    /// The camera stick turns it; the move stick across turns it after a hero running sideways
+    /// (side-on, it turns to the line from the seat instead); left alone while the hero moves,
+    /// its pitch eases back to rest.
+    void Rotate(float step, Stick look, Stick move) {
+        const float unit = settings.scale;
+        look_in.x = Keep(look_in.x, look.x, LookFilter, step);
+        look_in.y = Keep(look_in.y, look.y, LookFilter, step);
+        const float speed = std::hypot(velocity.x, velocity.z) / unit;
+        const float turn = move.x * std::min(speed, 1.0f) * (1.0f - std::abs(look.x)) * (1.0f - std::abs(move.y) / 2);
+        turn_in = Keep(turn_in, turn, MoveFilter, step);
+        const float across = std::abs(velocity.x * std::cos(yaw) - velocity.z * std::sin(yaw)) / unit;
+        if (look.x != 0.0f) {
+            // The player's own turn is theirs: no side-on view until the next stretch.
+            side_on = false;
+            side_turned = true;
+        }
+        SideOn(step);
+        if (in_arena) {
+            yaw = Wrap(yaw + Wrap(-yaw) * Blend(step, ArenaTurnTime));
+        } else if (side_on) {
+            yaw = Wrap(yaw + Wrap(std::atan2(-hero.x, -hero.z) - yaw) * Blend(step, SideTurnTime));
+        } else {
+            yaw = Wrap(yaw - (settings.yaw_speed * look_in.x + settings.turn_by_move * std::min(across, 1.0f) * turn_in) *
+                                 step);
+        }
+
+        const float tilt = -settings.pitch_speed * look_in.y * step;
+        const float room = tilt < 0.0f ? pitch - settings.pitch_min : settings.pitch_max - pitch;
+        pitch = std::clamp(pitch + tilt * std::min(1.0f, std::max(room, 0.0f) / PitchSoftBand), settings.pitch_min,
+                           settings.pitch_max);
+
+        if (look.x != 0.0f || look.y != 0.0f) {
+            idle_for = 0.0f;
+            resting = false;
+            return;
+        }
+        idle_for += step;
+        if (idle_for < RestAfter) {
+            return;
+        }
+        if (!resting) {
+            resting = true;
+            rest_from = pitch;
+            rested = 0.0f;
+        }
+        rested += step * std::hypot(move.x, move.y);
+        pitch = Mix(rest_from, settings.rest_pitch, Ease(rested / RestDuration));
+    }
+
+    /// The height the camera follows: the ground under the hero, not their jumps.
+    /// A fall to the end (far below, or the hero lost while falling) fades the picture to black
+    /// and keeps it so until a while after they are back (the camera has gone to them unseen),
+    /// as the 2024 game does round its respawn.
+    void FadeAtTheEnd(float step, bool seen) {
+        const float unit = settings.scale;
+        const bool at_the_end = watching_fall && (!seen || hero.y < stood - FadeBelow * unit);
+        dark_for = at_the_end ? DarkAfter : std::max(0.0f, dark_for - step);
+        const bool dark = at_the_end || dark_for > 0.0f;
+        head.dim = dark ? std::min(1.0f, head.dim + step / FadeInTime) : std::max(0.0f, head.dim - step / FadeOutTime);
+    }
+
+    /// The floor under the hero the ground cast found (its sphere's stop, less its radius).
+    std::optional<float> Floor(std::span<const float> hits) const {
+        if (hits.empty() || hits[0] >= 1.0f || casts_sent.empty()) {
+            return std::nullopt;
+        }
+        const Cast& down = casts_sent[0];
+        return down.from.y + (down.to.y - down.from.y) * hits[0] - down.radius;
+    }
+
+    void CastGround() {
+        const float unit = settings.scale;
+        casts.push_back({{hero.x, hero.y + GroundCastLift * unit, hero.z},
+                         {hero.x, hero.y - GroundCastLength * unit, hero.z},
+                         CastRadius * unit});
+    }
+
+    /// A hero dropping fast (not sinking in water) well below where they last stood with no floor
+    /// near under them is falling to their end (or far down): the camera keeps its height, goes on
+    /// across with them and turns down to watch them go (as the 2024 game's FallDeath camera
+    /// does), until they are back where they fell from (brought back), have stood a while on a
+    /// floor down there or have been still longer (on something the cast does not find, as
+    /// water), and are taken up.
+    bool WatchFall(float step, std::span<const float> hits) {
+        const float unit = settings.scale;
+        const std::optional<float> floor = Floor(hits);
+        if (!watching_fall) {
+            const bool near_floor = floor && hero.y - *floor < FloorNear * unit;
+            watching_fall = !near_floor && hero.y < stood - FallingDrop * unit && velocity.y < -FallingSpeed * unit;
+            if (!watching_fall) {
+                return false;
+            }
+            landed_for = still_for = 0.0f;
+            fall_last = hero;
+            fall_across = {mount.x - hero.x, 0.0f, mount.z - hero.z};
+        } else {
+            const bool grounded = floor && hero.y - *floor < GroundedGap * unit;
+            landed_for = grounded ? landed_for + step : 0.0f;
+            // Still: staying near one place (bobbing on water counts).
+            if (std::hypot(hero.x - fall_last.x, hero.y - fall_last.y, hero.z - fall_last.z) < StillWithin * unit) {
+                still_for += step;
+            } else {
+                fall_last = hero;
+                still_for = 0.0f;
+            }
+            if (hero.y >= stood - FallingDrop * unit || landed_for >= LandedAfterFall ||
+                still_for >= StillAfterFall) {
+                // Taken up again at once (not after FollowAfter, from the seat); brought back to
+                // where they fell from, facing the way the seat does, not from where the fall
+                // was watched.
+                brought_back = hero.y >= stood - FallingDrop * unit;
+                watching_fall = false;
+                mounted = false;
+                seen_for = FollowAfter;
+                return true;
+            }
+        }
+        CastGround();
+        casts_sent = casts;
+        mount = {hero.x + fall_across.x, mount.y, hero.z + fall_across.z};
+        const Vec to{hero.x - mount.x, hero.y - mount.y, hero.z - mount.z};
+        look_yaw = Wrap(look_yaw + Wrap(std::atan2(-to.x, -to.z) - look_yaw) * Blend(step, FallWatchTurnTime));
+        look_pitch += (std::atan2(to.y, std::hypot(to.x, to.z)) - look_pitch) * Blend(step, FallWatchTurnTime);
+        head.yaw = look_yaw;
+        head.pitch = look_pitch;
+        return true;
+    }
+
+    void FollowGround(float step, std::span<const float> hits) {
+        const float unit = settings.scale;
+        const std::optional<float> floor = Floor(hits);
+        if (!floor) {
+            // Eased from where it is each update, sooner the longer nothing is found.
+            lost_for += step / (hero.y <= ground ? LostBelow : LostAbove);
+            ground = Mix(ground, hero.y, Ease(lost_for));
+        } else if (hero.y - *floor < GroundedGap * unit) {
+            ground = stood = hero.y;
+            fallen_for = lost_for = 0.0f;
+        } else if (*floor > ground) {
+            ground = Keep(ground, *floor, GroundRise, step);
+            fallen_for = lost_for = 0.0f;
+        } else if (hero.y < ground) {
+            lost_for = 0.0f;
+            fallen_for += step;
+            const float keep = fallen_for < FallDelay
+                                   ? FallStart
+                                   : Mix(FallStart, FallEnd, Ease((fallen_for - FallDelay) / FallDuration));
+            ground = Keep(ground, hero.y, keep, step);
+        }
+        CastGround();
+    }
+
+    /// Moves the point followed after the hero (a step ahead of them), soon when they are fast.
+    void Follow(float step, float share) {
+        const float unit = settings.scale;
+        const float pitch_share = (pitch - settings.pitch_min) / (settings.pitch_max - settings.pitch_min);
+        const float in = intrusion / radius;
+        const float weight = std::max(pitch_share < LowShare ? 1.0f - pitch_share / LowShare : 0.0f, in);
+        const float span = Mix(HeightSpanFar, HeightSpanNear, weight) * unit;
+        const float off = (1.0f - weight) * HeightOffset * unit;
+        const float rise = std::clamp((hero.y - off - ground) / span, 0.0f, 1.0f);
+        const float height = ground + std::sin(rise * std::numbers::pi_v<float> / 2) * (hero.y - ground);
+
+        float across = 1.0f - std::pow(std::min(std::hypot(velocity.x, velocity.z) / unit / FollowFastSpeed, 1.0f),
+                                      FollowFastPower);
+        float up = 1.0f - std::pow(std::min(std::max(0.0f, -velocity.y) / unit / FollowFastSpeed, 1.0f),
+                                  FollowFastPower);
+        if (in > CloseIn) {
+            up *= (1.0f - in) / (1.0f - CloseIn);
+        }
+        if (share < NearShare) {
+            up *= share / NearShare;
+        }
+        pivot.x = Keep(pivot.x, hero.x + velocity.x * step, across * FollowXZ, step);
+        pivot.z = Keep(pivot.z, hero.z + velocity.z * step, across * FollowXZ, step);
+        pivot.y = Keep(pivot.y, height, up * FollowY, step);
+    }
+
+    /// Pulls the camera in at once to what the casts behind it left clear, and lets it out
+    /// slowly, only while the player plays.
+    void KeepClear(float step, Stick look, Stick move, std::span<const float> hits) {
+        const float unit = settings.scale;
+        float needed = 0.0f;
+        for (std::size_t i = FirstWallCast; i < std::min(hits.size(), FirstWallCast + WallCasts); ++i) {
+            needed = std::max(needed, radius * (1.0f - hits[i]));
+        }
+        needed = std::min(needed, std::max(0.0f, radius - NearestOut * unit));
+        if (intrusion <= needed) {
+            intrusion = needed;
+            blocked_for = 0.0f;
+        } else {
+            const float playing = std::max(std::hypot(look.x, look.y), std::hypot(move.x, move.y));
+            played = Keep(played, playing, playing > played ? PlayRise : PlayFall, step);
+            blocked_for += step * played;
+            const float easing = std::clamp((blocked_for - HoldIn) / EaseOut, 0.0f, 1.0f);
+            intrusion = std::min(Keep(intrusion, needed, OutFilter + (1.0f - OutFilter) * (1.0f - easing * played), step),
+                                 radius);
+        }
+        const float length = radius / (std::cos(CastAcross / 2) * std::cos(CastUp / 2));
+        for (const float across : {-CastAcross / 2, CastAcross / 2}) {
+            for (const float up : {-CastUp / 2, CastUp / 2}) {
+                const Vec way = Back(yaw + across, pitch + up);
+                casts.push_back({orbited,
+                                 {orbited.x + way.x * length, orbited.y + way.y * length, orbited.z + way.z * length},
+                                 CastRadius * unit});
+            }
+        }
+        casts_sent = casts;
+    }
+
+    /// How open the space round the hero is: how far, on the whole, rays out from above them (over
+    /// railings and steps, not over walls) went before something stopped them (the last update's,
+    /// before any are sent anew).
+    void ReadOpenness(std::span<const float> hits) {
+        if (casts_sent.size() == FirstOpenCast + OpenCasts && hits.size() >= FirstOpenCast + OpenCasts) {
+            float sum = 0.0f;
+            for (std::size_t i = FirstOpenCast; i < FirstOpenCast + OpenCasts; ++i) {
+                sum += hits[i];
+            }
+            openness = sum / OpenCasts;
+        }
+    }
+
+    /// The rays for the next update's openness.
+    void CastOpenness() {
+        const float unit = settings.scale;
+        const Vec from{hero.x, hero.y + OpenAbove * unit, hero.z};
+        for (std::size_t i = 0; i < OpenCasts; ++i) {
+            const float heading = 2.0f * std::numbers::pi_v<float> * static_cast<float>(i) / OpenCasts;
+            casts.push_back({from,
+                             {from.x + std::sin(heading) * OpenReach * unit, from.y,
+                              from.z + std::cos(heading) * OpenReach * unit},
+                             CastRadius * unit});
+        }
+        casts_sent = casts;
+    }
+
+    /// Of the camera's extra distance in the open: none with walls about (a corridor), all of it
+    /// with nothing round the hero.
+    float OpenShare() const {
+        return std::clamp((openness - EnclosedBelow) / (1.0f - EnclosedBelow), 0.0f, 1.0f);
+    }
+
+    void InMenu(float step, const Menu& menu) {
+        const std::span<const MenuStep> steps = menu.steps;
+        mounted = false;
+        Approach(mount, {}, Blend(step, ReturnTime));
+        MenuStep heading;
+        if (!steps.empty()) {
+            if (chosen >= steps.size()) {
+                chosen = 0;
+                for (std::size_t i = 1; i < steps.size(); ++i) {
+                    if (std::abs(Wrap(steps[i].yaw - look_yaw)) < std::abs(Wrap(steps[chosen].yaw - look_yaw))) {
+                        chosen = i;
+                    }
+                }
+            }
+            if (menu.step != 0 && menu.step != last_step) {
+                const std::size_t count = steps.size();
+                chosen = (chosen + (menu.step > 0 ? count - 1 : 1)) % count;
+            }
+            last_step = menu.step;
+            if (menu.home) {
+                for (std::size_t i = 0; i < steps.size(); ++i) {
+                    if (std::abs(steps[i].yaw) < std::abs(steps[chosen].yaw)) {
+                        chosen = i;
+                    }
+                }
+            }
+            heading = steps[chosen];
+        }
+        look_yaw = Wrap(look_yaw + Wrap(heading.yaw - look_yaw) * Blend(step, ReturnTime));
+        look_pitch += (heading.pitch - look_pitch) * Blend(step, ReturnTime);
+        head.yaw = look_yaw;
+        head.pitch = look_pitch;
+    }
+
+    /// The target's sweep so far, and how long the hero has rested since it went.
+    struct Shot {
+        Vec low;
+        Vec high;
+        float rested{};
+    };
+
+    /// A shot is watched from the seat once its target has been seen swinging, while it is
+    /// there and, once the hero has gone (shot), until it rests again wherever it comes down.
+    bool Shooting(float step, const std::optional<Vec>& hero_at, const std::optional<Vec>& shot_at) {
+        if (!shot_at && shot && !Swinging()) {
+            shot = std::nullopt;
+        }
+        if (shot_at) {
+            if (!shot) {
+                shot = Shot{*shot_at, *shot_at};
+            }
+            shot->low = {std::min(shot->low.x, shot_at->x), std::min(shot->low.y, shot_at->y),
+                         std::min(shot->low.z, shot_at->z)};
+            shot->high = {std::max(shot->high.x, shot_at->x), std::max(shot->high.y, shot_at->y),
+                          std::max(shot->high.z, shot_at->z)};
+            shot->rested = 0.0f;
+        } else if (shot && hero_at && step > 0.0f) {
+            const bool still = std::hypot(hero_at->x - shot_hero.x, hero_at->y - shot_hero.y,
+                                          hero_at->z - shot_hero.z) < RestSpeed * step;
+            shot->rested = still ? shot->rested + step : 0.0f;
+            if (shot->rested >= RestedAfterShot) {
+                shot = std::nullopt;
+            }
+        }
+        if (hero_at) {
+            shot_hero = *hero_at;
+        }
+        return shot && Swinging();
+    }
+
+    bool Swinging() const {
+        return std::hypot(shot->high.x - shot->low.x, shot->high.y - shot->low.y, shot->high.z - shot->low.z) >=
+               SwingAtLeast;
+    }
+
+    /// From the seat, facing the middle of what the target has swept (where a shot is aimed).
+    void AtShot(float step) {
+        mounted = false;
+        chosen = NoneChosen;
+        Approach(mount, {}, Blend(step, ReturnTime));
+        const Vec middle{(shot->low.x + shot->high.x) / 2, (shot->low.y + shot->high.y) / 2,
+                         (shot->low.z + shot->high.z) / 2};
+        const Vec to{middle.x - mount.x, middle.y - mount.y, middle.z - mount.z};
+        look_yaw = Wrap(look_yaw + Wrap(std::atan2(-to.x, -to.z) - look_yaw) * Blend(step, ReturnTime));
+        look_pitch += (std::atan2(to.y, std::hypot(to.x, to.z)) - look_pitch) * Blend(step, ReturnTime);
+        head.yaw = look_yaw;
+        head.pitch = look_pitch;
+    }
+
+    void Seat(float step, Stick look) {
+        mounted = false;
+        chosen = NoneChosen;
+        Approach(mount, {}, Blend(step, ReturnTime));
+        // Carries on from where the head looked; the stick turns it from there.
+        look_yaw = Wrap(look_yaw - look.x * SeatTurnSpeed * step);
+        look_pitch = std::clamp(look_pitch + look.y * SeatTiltSpeed * step, -MaxSeatPitch, MaxSeatPitch);
+        head.yaw = look_yaw;
+        head.pitch = look_pitch;
+    }
+
+    Settings settings;
+    bool mounted{};
+    float seen_for{};
+    float gone_for{};
+    float mounted_for{};
+    Vec last_seen;
+    Vec hero;
+    Vec velocity;
+    Vec pivot;
+    Vec orbited;
+    Vec mount;
+    float yaw{};
+    float pitch{};
+    float radius{};
+    float intrusion{};
+    float played{};
+    float blocked_for{};
+    Stick look_in;
+    float turn_in{};
+    float idle_for{};
+    bool resting{};
+    float rest_from{};
+    float rested{};
+    float ground{};
+    float fallen_for{};
+    float lost_for{};
+    std::vector<Cast> casts;
+    std::vector<Cast> casts_sent;
+    static constexpr std::size_t NoneChosen = static_cast<std::size_t>(-1);
+    std::size_t chosen{NoneChosen};
+    int last_step{};
+    float look_yaw{};
+    float look_pitch{};
+    float lean{};
+    std::optional<Shot> shot;
+    bool in_arena{};
+    bool side_on{};
+    bool side_turned{};
+    float across_for{};
+    float along_for{};
+    float radius_extra{};
+    float openness{};
+    float stood{};
+    bool watching_fall{};
+    bool brought_back{};
+    float landed_for{};
+    float dark_for{};
+    float still_for{};
+    Vec fall_last;
+    Vec fall_across; // from the hero to the camera, across, as the fall began
+    Vec shot_hero;
+    Head head;
+    double last{};
+    bool started{};
+};
+
+} // namespace Input
