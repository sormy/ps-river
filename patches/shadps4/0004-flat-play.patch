+constexpr float RingsWithin = 8.0f;        // metres from the controller
+constexpr std::array<u8, 3> HeadMotions{2, 0, 4};
+constexpr float HeadLength = 0.18f; // metres from its front body to its back one
+constexpr float HeadTolerance = 0.05f;
