+// faces (the front, the middle and the back of it, each moved its own way) and two more, then
+// the hero. Menus have other bodies there, which is how a level is told from them.
+constexpr u32 HeadFront = 0;
+constexpr u32 HeadMiddle = 1;
+constexpr u32 HeadBack = 2;
+constexpr u32 HeroBody = 5;
+constexpr u32 ControllerBody = 7;
+// At a level's end the hero waits in the controller, a catapult, to be shot through the goal's
+// rings, which the goal keeps moving a few metres ahead and above it (their bodies are this
+// kind; others of it lie about, below).
+constexpr u32 GoalRingsKind = 0x20;
