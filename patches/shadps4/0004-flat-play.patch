+}
+
+/// The rooms constructed lately, oldest overwritten (a level and its overlays live at once).
+constexpr std::size_t KeptRooms = 64;
+std::array<std::atomic<VAddr>, KeptRooms> rooms{};
+std::atomic<std::size_t> next_room{0};
+
+PS4_SYSV_ABI void NoteRoom(VAddr room) {
+    rooms[next_room.fetch_add(1, std::memory_order_relaxed) % KeptRooms].store(room, std::memory_order_release);
+}
+
+bool HasVtable(VAddr object, u64 vtable, u64 size) {
+    return object != 0 && Core::Memory::Instance()->IsValidMapping(object, size) &&
+           Read<u64>(object) == known_base + vtable;
+}
+
+/// Whether the pause menu holds the room played: the newest one still alive. (One left behind,
+/// as the world map's while a level is played, stays paused.)
+bool RoomPaused(const Build& build) {
+    constexpr u64 Size = Builds::Room::Paused + sizeof(u32);
+    if (build.room_vtable == 0) {
+        return false;
+    }
+    const std::size_t next = next_room.load(std::memory_order_acquire);
+    for (std::size_t back = 1; back <= std::min(next, KeptRooms); ++back) {
+        const VAddr room = rooms[(next - back) % KeptRooms].load(std::memory_order_acquire);
+        if (HasVtable(room, build.room_vtable, Size)) {
+            return Read<u32>(room + Builds::Room::Paused) != 0;
+        }
+    }
+    return false;
+}
