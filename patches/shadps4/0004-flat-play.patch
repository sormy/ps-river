diff --git a/tools/tests/flat_camera_test.cpp b/tools/tests/flat_camera_test.cpp
new file mode 100644
index 0000000..8a07542
--- /dev/null
+++ b/tools/tests/flat_camera_test.cpp
@@ -0,0 +1,716 @@
+// Checks the head a title made for a headset gets on a flat screen. At the seat: the stick turns
+// the view freely, the headbutt goes out and back at its speed, a stall does not jump the head.
+// Behind a hero (the flat platformer camera): it orbits a point above them at the distance its
+// pitch calls for; the camera stick turns it and it stays; running sideways with the move
+// stick turns it after the hero, running at it does not; its pitch rests back only while the
+// hero moves; a wall behind it pulls it in at once and it lets out only while played; its
+// height follows the ground, not jumps. The world's placement in tracking space comes out
+// right from what a title says of the head. A catapult's shot is watched from the seat.
+//
+//   clang++ -std=c++20 -I src tools/tests/flat_camera_test.cpp
+//       -o build/tests/flat_camera_test
+#include <cmath>
+#include <cstdio>
+#include <numbers>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "input/flat_camera.h"
+
+using Input::FlatCamera;
+using Input::WorldPlacement;
+using Vec = Input::TrackVec;
+using Stick = FlatCamera::Stick;
+
+static int failures = 0;
+
+static void Check(bool ok, const std::string& what) {
+    std::printf("%s  %s\n", ok ? "ok  " : "FAIL", what.c_str());
+    failures += ok ? 0 : 1;
+}
+
+static bool Near(float a, float b, float tolerance = 1e-3f) {
+    return std::abs(a - b) < tolerance;
+}
+
+static constexpr double Rate = 250.0;
+static constexpr float Pi = std::numbers::pi_v<float>;
+
+/// A level: a floor, maybe a wall across the way behind the camera (a plane of constant z) and
+/// maybe walls either side (a corridor: planes of constant x, this far out).
+struct Level {
+    float floor = -1.0f;
+    std::optional<float> wall;
+    std::optional<float> sides;
+
+    /// How far along a cast the sphere first touches the level.
+    float Hit(const FlatCamera::Cast& c) const {
+        float first = 1.0f;
+        const auto plane = [&](float from, float to, float at) {
+            if (to == from) {
+                return;
+            }
+            const float t = (at - from) / (to - from);
+            if (t >= 0.0f && t < first) {
+                first = t;
+            }
+        };
+        plane(c.from.y, c.to.y, floor + c.radius);
+        if (wall) {
+            plane(c.from.z, c.to.z, *wall - c.radius);
+        }
+        if (sides) {
+            plane(c.from.x, c.to.x, *sides - c.radius);
+            plane(c.from.x, c.to.x, -*sides + c.radius);
+        }
+        return first;
+    }
+};
+
+struct Rig {
+    FlatCamera camera;
+    double now = 0.0;
+    Level level;
+
+    /// Runs the camera for `seconds` at the emulator's rate, answering its casts a frame late;
+    /// `hero(t)` says where the hero is.
+    template <typename Hero>
+    FlatCamera::Head Run(double seconds, Stick look, Stick move, Hero hero) {
+        FlatCamera::Head out = camera.Last();
+        for (double end = now + seconds; now < end;) {
+            now += 1.0 / Rate;
+            std::vector<float> hits;
+            for (const FlatCamera::Cast& c : camera.Casts()) {
+                hits.push_back(level.Hit(c));
+            }
+            out = camera.Update(now, look, move, hero(now), hits);
+        }
+        return out;
+    }
+};
+
+static std::optional<Vec> None(double) {
+    return std::nullopt;
+}
+
+static auto Standing(const Vec& at) {
+    return [at](double) { return std::optional<Vec>{at}; };
+}
+
+/// From the camera to the point it orbits.
+static float Out(const FlatCamera& camera) {
+    const Vec look = camera.LookPoint();
+    const Vec& at = camera.Last().position;
+    return std::hypot(at.x - look.x, at.y - look.y, at.z - look.z);
+}
+
+/// How far out the camera belongs at the pitch it looks down at.
+static float Belongs(const FlatCamera& camera) {
+    return camera.Frame(-camera.Last().pitch).radius;
+}
+
+static void AtTheSeat() {
+    Rig rig;
+    auto out = rig.Run(0.5, {1.0f, 0.0f}, {}, None);
+    Check(Near(out.yaw, -FlatCamera::SeatTurnSpeed * 0.5f, 0.02f), "at the seat the stick turns the view right");
+    const float turned = out.yaw;
+    out = rig.Run(1.0, {}, {}, None);
+    Check(Near(out.yaw, turned), "let go, the view stays turned");
+    out = rig.Run(2.0 * Pi / FlatCamera::SeatTurnSpeed, {1.0f, 0.0f}, {}, None);
+    Check(Near(Input::Wrap(out.yaw - turned), 0.0f, 0.05f), "it turns all the way round, without a limit");
+    out = rig.Run(5.0, {0.0f, 1.0f}, {}, None);
+    Check(Near(out.pitch, FlatCamera::MaxSeatPitch), "it looks up no further than straight up nearly");
+    Rig resting;
+    out = resting.Run(1.0, {0.1f, -0.1f}, {}, None);
+    Check(Near(out.yaw, 0.0f) && Near(out.pitch, 0.0f), "a stick at rest turns nothing");
+
+}
+
+static void Lean() {
+    // Held, a lean moves the head to that side of where it looks, at its speed; let go, back.
+    FlatCamera camera;
+    double now = 0.0;
+    FlatCamera::Head out = camera.Last();
+    for (; now < 1.0; now += 1.0 / Rate) {
+        out = camera.Update(now, {}, {}, std::nullopt, {}, {}, 1);
+    }
+    Check(Near(out.position.x, FlatCamera::LeanDistance), "a lean right moves the head right, as far as it goes");
+    for (; now < 2.0; now += 1.0 / Rate) {
+        out = camera.Update(now, {}, {}, std::nullopt, {}, {}, 0);
+    }
+    Check(Near(out.position.x, 0.0f), "let go, it comes back");
+}
+
+static void CatapultShot() {
+    // The hero waits in the controller to be shot at a target swinging across ahead: the view
+    // goes to the seat and faces the middle of the swing, whatever the stick; shot, the hero
+    // flies off and the view stays; once the hero rests where it came down, it is followed.
+    FlatCamera camera;
+    const Vec in_controller{0.0f, -0.4f, -0.3f};
+    static constexpr float SwingCycle = 7.0f;
+    double now = 0.0;
+    FlatCamera::Head out = camera.Last();
+    for (; now < 2.0; now += 1.0 / Rate) {
+        out = camera.Update(now, {}, {}, in_controller);
+    }
+    for (; now < 10.0; now += 1.0 / Rate) {
+        const float swing = std::sin(2.0f * Pi * static_cast<float>(now) / SwingCycle);
+        const Vec rings{swing, 1.0f, -5.0f};
+        out = camera.Update(now, {1.0f, 1.0f}, {}, in_controller, {}, {}, 0, rings);
+    }
+    const float up = std::atan2(1.0f, 5.0f);
+    FlatCamera still;
+    FlatCamera::Head kept = still.Last();
+    for (double t = 0.0; t < 6.0; t += 1.0 / Rate) {
+        kept = still.Update(t, {1.0f, 0.0f}, {}, in_controller, {}, {}, 0, Vec{0.0f, 1.0f, -5.0f});
+    }
+    Check(!Near(kept.yaw, 0.0f, 0.1f), "a target that does not swing is not one: the stick still turns the view");
+    Check(Near(out.position.x, 0.0f, 0.01f) && Near(out.position.y, 0.0f, 0.01f) && Near(out.position.z, 0.0f, 0.01f),
+          "waiting to be shot: at the seat");
+    Check(Near(out.yaw, 0.0f, 0.02f) && Near(out.pitch, up, 0.02f),
+          "facing the middle of the target's swing, the stick held over");
+    static constexpr float ShotSpeed = 20.0f;
+    const double shot = now;
+    for (; now < shot + 2.0; now += 1.0 / Rate) {
+        const Vec flying{0.0f, 0.5f, in_controller.z - ShotSpeed * static_cast<float>(now - shot)};
+        out = camera.Update(now, {}, {}, flying);
+    }
+    Check(Near(out.position.z, 0.0f, 0.01f) && Near(out.yaw, 0.0f, 0.02f) && Near(out.pitch, up, 0.02f),
+          "shot, the hero flies off and the view stays");
+    const Vec landed{0.0f, -1.0f, -3.0f};
+    for (; now < shot + 5.0; now += 1.0 / Rate) {
+        out = camera.Update(now, {}, {}, landed);
+    }
+    Check(out.position.z > landed.z && out.position.z < -1.0f, "come down and at rest, the hero is followed");
+}
+
+static void Arena() {
+    // In a room built round the seat the camera behind the hero turns to the way the seat faces
+    // and keeps it whatever the stick, and stands further out.
+    const Vec hero{2.0f, -1.0f, -3.0f};
+    // (Without the open's extra distance, the arena's own shows.)
+    FlatCamera::Settings no_open_extra;
+    no_open_extra.open_radius_extra = 0.0f;
+    Rig open, arena;
+    open.camera = arena.camera = FlatCamera{no_open_extra};
+    open.Run(4.0, {}, {}, Standing(hero));
+    FlatCamera::Head out{};
+    for (double now = 0.0; now < 4.0; now += 1.0 / Rate) {
+        std::vector<float> hits;
+        for (const FlatCamera::Cast& c : arena.camera.Casts()) {
+            hits.push_back(arena.level.Hit(c));
+        }
+        out = arena.camera.Update(now, {1.0f, 0.0f}, {}, hero, hits, {}, 0, std::nullopt, true);
+    }
+    Check(Near(out.yaw, 0.0f, 0.02f), "in an arena: facing the seat's way, the stick held over");
+    Check(Out(arena.camera) > Out(open.camera) + 0.9f, "in an arena: further out");
+}
+
+static void OpenSpace() {
+    // In the open the camera stands further out than its pitch alone calls for; in a corridor,
+    // about as far as that.
+    const Vec hero{0.0f, -1.0f, -3.0f};
+    static constexpr float CorridorHalfWidth = 0.6f;
+    static constexpr float Settle = 8.0f;
+    Rig open;
+    open.Run(Settle, {}, {}, Standing(hero));
+    Rig corridor;
+    corridor.level.sides = CorridorHalfWidth;
+    corridor.Run(Settle, {}, {}, Standing(hero));
+    const float pitch_alone =
+        FlatCamera::Settings{}.radius_near +
+        (FlatCamera::Settings{}.radius_far - FlatCamera::Settings{}.radius_near) * open.camera.Frame(-open.camera.Last().pitch).share;
+    Check(Belongs(open.camera) > pitch_alone + 0.8f,
+          "in the open: further out (" + std::to_string(Belongs(open.camera) - pitch_alone) + " more)");
+    Check(Belongs(corridor.camera) < pitch_alone + 0.3f,
+          "in a corridor: about as far as its pitch calls for (" + std::to_string(Belongs(corridor.camera) - pitch_alone) +
+              " more)");
+}
+
+static void SideOn() {
+    // Running across in front of the seat (a side-on stretch): the view turns to the line from
+    // the seat to the hero, not after their running; round the seat, it goes round with them.
+    static constexpr float Ahead = 4.0f;
+    static constexpr float RunSpeed = 1.5f;
+    Rig across;
+    across.Run(2.0, {}, {}, Standing(Vec{-3.0f, -1.0f, -Ahead}));
+    const double start = across.now;
+    const auto running = [&](double t) {
+        return std::optional<Vec>{Vec{-3.0f + RunSpeed * static_cast<float>(t - start), -1.0f, -Ahead}};
+    };
+    auto out = across.Run(4.0, {}, {1.0f, 0.0f}, running);
+    const Vec end = *running(across.now);
+    const float seat_line = std::atan2(-end.x, -end.z);
+    Check(Near(out.yaw, seat_line, 0.25f), "running across before the seat: the view on the seat's line (" +
+                                               std::to_string(out.yaw) + " for " + std::to_string(seat_line) + ")");
+    // Turned by the player there, the view stays where it was turned (no spring back).
+    across.Run(0.4, {1.0f, 0.0f}, {1.0f, 0.0f}, running);
+    const float turned = across.camera.Last().yaw;
+    out = across.Run(3.0, {}, {1.0f, 0.0f}, running);
+    const float back_then = std::abs(Input::Wrap(turned - seat_line));
+    const float back_now = std::abs(Input::Wrap(out.yaw - std::atan2(-running(across.now)->x, -running(across.now)->z)));
+    Check(back_then > 0.3f && back_now >= back_then - 0.05f,
+          "turned by the player on the way, the view does not spring back to the seat's line (" +
+              std::to_string(back_now) + " off it, was " + std::to_string(back_then) + ")");
+    static constexpr float Round = 0.25f; // radians a second round the seat
+    Rig round;
+    round.Run(2.0, {}, {}, Standing(Vec{0.0f, -1.0f, -Ahead}));
+    const double off = round.now;
+    const auto circling = [&](double t) {
+        const float a = Round * static_cast<float>(t - off);
+        return std::optional<Vec>{Vec{-Ahead * std::sin(a), -1.0f, -Ahead * std::cos(a)}};
+    };
+    out = round.Run(8.0, {}, {}, circling);
+    const Vec at = *circling(round.now);
+    Check(Near(out.yaw, std::atan2(-at.x, -at.z), 0.3f), "going round the seat: the view goes round with the hero (" +
+                                                             std::to_string(out.yaw) + " for " +
+                                                             std::to_string(std::atan2(-at.x, -at.z)) + ")");
+}
+
+static void FallsToTheEnd() {
+    // A hero falling off with no floor under them is watched from where the camera was; back on
+    // a floor, they are followed again.
+    const Vec stand{0.0f, -1.0f, -3.0f};
+    Rig rig;
+    rig.Run(3.0, {}, {}, Standing(stand));
+    const Vec before = rig.camera.Last().position;
+    static constexpr float FarBelow = 15.0f; // metres: something far down (a lower roof, a death plane)
+    rig.level.floor = stand.y - FarBelow;
+    static constexpr float Gravity = 9.8f;
+    const double off = rig.now;
+    const auto falling = [&](double t) {
+        const float down = Gravity / 2 * static_cast<float>((t - off) * (t - off));
+        return std::optional<Vec>{Vec{stand.x, stand.y - down, stand.z}};
+    };
+    auto out = rig.Run(1.5, {}, {}, falling);
+    const float moved = std::hypot(out.position.x - before.x, out.position.y - before.y, out.position.z - before.z);
+    // Metres down with the hero before it is seen falling (its speed tells a fall from sinking).
+    static constexpr float FollowsAtMost = 2.5f;
+    Check(moved < FollowsAtMost, "falling off: the camera stops where it was (" + std::to_string(moved) + " m, the hero " +
+                                     std::to_string(stand.y - falling(rig.now)->y) + " m down)");
+    Check(out.pitch < -Pi / 4, "and turns down after the hero (" + std::to_string(out.pitch) + ")");
+    const Vec at_the_end{stand.x, rig.level.floor, stand.z};
+    rig.Run(1.0, {}, {}, None);
+    out = rig.Run(0.5, {}, {}, Standing(at_the_end));
+    const float dipped = before.y - out.position.y;
+    Check(dipped < FollowsAtMost, "lost at the end below and seen there again: not followed down (" + std::to_string(dipped) + " m)");
+    // (Brought back into the controller, held up in the air: no floor under them.)
+    rig.level.floor = -1000.0f;
+    static constexpr float BroughtAside = 3.0f; // the respawn's place, off to the side
+    const Vec respawn{stand.x + BroughtAside, stand.y, stand.z};
+    out = rig.Run(0.25, {}, {}, Standing(respawn));
+    Check(Near(Out(rig.camera), Belongs(rig.camera), 0.1f) && out.position.y > stand.y,
+          "brought back where they fell from, the hero is taken up at once (" +
+              std::to_string(Out(rig.camera)) + " out of " + std::to_string(Belongs(rig.camera)) + ")");
+    Check(Near(out.yaw, 0.0f, 0.05f), "facing the way the seat does (" + std::to_string(out.yaw) + ")");
+    rig.level.floor = -1.0f;
+    out = rig.Run(3.0, {}, {}, Standing(stand));
+    const Vec lower{stand.x, stand.y - FarBelow, stand.z};
+    rig.level.floor = lower.y;
+    const double again = rig.now;
+    const auto down_there = [&](double t) {
+        const float down = std::min(Gravity / 2 * static_cast<float>((t - again) * (t - again)), FarBelow);
+        return std::optional<Vec>{Vec{stand.x, stand.y - down, stand.z}};
+    };
+    out = rig.Run(5.0, {}, {}, down_there);
+    Check(out.position.y > lower.y && out.position.y < stand.y, "come down far below and staying there: followed there");
+}
+
+static void FallsGoingOn() {
+    // Falling off while running on: the camera goes on across with the hero at the height it
+    // had, looking down at them.
+    const Vec stand{0.0f, -1.0f, -3.0f};
+    static constexpr float RunSpeed = 2.0f;
+    Rig rig;
+    rig.Run(3.0, {}, {}, Standing(stand));
+    const Vec before = rig.camera.Last().position;
+    rig.level.floor = -1000.0f;
+    static constexpr float Gravity = 9.8f;
+    const double off = rig.now;
+    const auto falling = [&](double t) {
+        const float s = static_cast<float>(t - off);
+        return std::optional<Vec>{Vec{stand.x, stand.y - Gravity / 2 * s * s, stand.z - RunSpeed * s}};
+    };
+    const auto out = rig.Run(1.5, {}, {}, falling);
+    const Vec hero = *falling(rig.now);
+    Check(std::abs(out.position.y - before.y) < 2.5f && out.position.z - hero.z < before.z - stand.z + 0.5f,
+          "falling while running on: the camera goes on across with the hero (" +
+              std::to_string(out.position.z - hero.z) + " m behind) and holds its height (" +
+              std::to_string(before.y - out.position.y) + " m down)");
+}
+
+static void FadesAtTheEnd() {
+    // Falling to the end: the picture fades to black; brought back, the camera is in its place
+    // before it fades back in. A short drop (water below) does not fade.
+    const Vec stand{0.0f, -1.0f, -3.0f};
+    Rig rig;
+    rig.Run(3.0, {}, {}, Standing(stand));
+    rig.level.floor = -1000.0f;
+    static constexpr float Gravity = 9.8f;
+    const double off = rig.now;
+    const auto falling = [&](double t) {
+        const float s = static_cast<float>(t - off);
+        return std::optional<Vec>{Vec{stand.x, stand.y - Gravity / 2 * s * s, stand.z}};
+    };
+    auto out = rig.Run(2.0, {}, {}, falling);
+    Check(Near(out.dim, 1.0f), "fallen to the end: the picture black (" + std::to_string(out.dim) + ")");
+    out = rig.Run(0.5, {}, {}, None);
+    Check(Near(out.dim, 1.0f), "the hero lost there: still black");
+    out = rig.Run(0.3, {}, {}, Standing(stand));
+    Check(out.dim > 0.5f && Near(Out(rig.camera), Belongs(rig.camera), 0.1f),
+          "brought back: the camera in its place while the picture is still dark");
+    out = rig.Run(1.5, {}, {}, Standing(stand));
+    Check(Near(out.dim, 0.0f), "then the picture fades back in");
+}
+
+static void SinksInWater() {
+    // Sinking in water (slower than a fall) far below where the hero stood: still followed.
+    const Vec stand{0.0f, -1.0f, -3.0f};
+    static constexpr float Depth = 7.0f;
+    static constexpr float SinkSpeed = 3.0f;
+    Rig rig;
+    rig.Run(3.0, {}, {}, Standing(stand));
+    rig.level.floor = -1000.0f;
+    const double off = rig.now;
+    const auto sinking = [&](double t) {
+        const float down = std::min(SinkSpeed * static_cast<float>(t - off), Depth);
+        return std::optional<Vec>{Vec{stand.x, stand.y - down, stand.z}};
+    };
+    const auto out = rig.Run(4.0, {}, {}, sinking);
+    const float gap = std::hypot(out.position.x - stand.x, out.position.y - (stand.y - Depth), out.position.z - stand.z);
+    Check(gap < 3.0f, "sinking in water: followed down (" + std::to_string(gap) + " m off)");
+}
+
+static void FallsIntoWater() {
+    // Falling into water far below (found by no cast) and bobbing there: once the hero stays
+    // about one place a while, they are followed there.
+    const Vec stand{0.0f, -1.0f, -3.0f};
+    static constexpr float Drop = 7.0f;
+    static constexpr float Bob = 0.05f;    // metres up and down
+    static constexpr float BobRate = 3.0f; // a second
+    Rig rig;
+    rig.Run(3.0, {}, {}, Standing(stand));
+    rig.level.floor = -1000.0f;
+    const double off = rig.now;
+    static constexpr float Gravity = 9.8f;
+    const auto into_water = [&](double t) {
+        const float fall = Gravity / 2 * static_cast<float>((t - off) * (t - off));
+        const float bob = fall < Drop ? 0.0f : Bob * std::sin(2.0f * Pi * BobRate * static_cast<float>(t));
+        return std::optional<Vec>{Vec{stand.x, stand.y - std::min(fall, Drop) + bob, stand.z}};
+    };
+    const auto mid = rig.Run(1.0, {}, {}, into_water);
+    Check(Near(mid.dim, 0.0f), "a drop into water is not the end: no fade");
+    const auto out = rig.Run(5.0, {}, {}, into_water);
+    const float gap = std::hypot(out.position.x - stand.x, out.position.y - (stand.y - Drop), out.position.z - stand.z);
+    Check(gap < 3.0f, "fallen into water and bobbing there: followed there (" + std::to_string(gap) + " m off)");
+}
+
+static void BehindTheHero() {
+    const Vec hero{0.0f, -1.0f, -3.0f};
+    Rig rig;
+    auto out = rig.Run(2.0, {}, {}, Standing(hero));
+    Check(Near(Out(rig.camera), Belongs(rig.camera), 0.02f), "mounted at the distance its pitch calls for");
+    Check(out.position.z > hero.z && out.position.y > hero.y, "mounted behind the hero and above them");
+    Check(Near(out.yaw, 0.0f, 0.02f) && out.pitch < 0.0f, "looking at the hero, down");
+
+    rig.Run(0.5, {1.0f, 0.0f}, {}, Standing(hero));
+    out = rig.Run(0.5, {}, {}, Standing(hero));
+    const float swung = out.yaw;
+    Check(swung < -0.5f, "the camera stick swings it round the hero");
+    out = rig.Run(3.0, {}, {}, Standing(hero));
+    Check(Near(out.yaw, swung, 0.02f), "let go, it stays where it was swung (no spring back)");
+
+    // Gone (a menu): back to the seat, looking the way it did when it let go.
+    rig.Run(FlatCamera::LeaveAfter + 0.05, {}, {}, None);
+    const float last_yaw = rig.camera.Last().yaw;
+    out = rig.Run(4.0, {}, {}, None);
+    Check(Near(out.position.x, 0.0f, 0.01f) && Near(out.position.z, 0.0f, 0.01f) && Near(out.yaw, last_yaw, 0.01f),
+          "with no hero it goes back to the seat, still looking the same way");
+}
+
+static void TurnsAfterTheHero() {
+    // Running sideways (move stick right, the hero going right across the view): it turns after
+    // them. Running at the camera, or sideways without moving: it does not.
+    const Vec start{0.0f, -1.0f, -3.0f};
+    const auto running = [&](Rig& rig, Vec way) {
+        const double from = rig.now;
+        return [=](double t) {
+            const float d = static_cast<float>(t - from);
+            return std::optional<Vec>{Vec{start.x + way.x * d, start.y, start.z + way.z * d}};
+        };
+    };
+    Rig sideways;
+    sideways.Run(2.0, {}, {}, Standing(start));
+    auto out = sideways.Run(2.0, {}, {1.0f, 0.0f}, running(sideways, {1.0f, 0.0f, 0.0f}));
+    Check(out.yaw < -0.3f, "running sideways turns the camera after the hero");
+
+    Rig at;
+    at.Run(2.0, {}, {}, Standing(start));
+    out = at.Run(1.0, {}, {0.0f, -1.0f}, running(at, {0.0f, 0.0f, 1.0f}));
+    Check(Near(out.yaw, 0.0f, 0.02f), "running at the camera does not swing it round");
+
+    Rig blocked;
+    blocked.Run(2.0, {}, {}, Standing(start));
+    out = blocked.Run(1.0, {}, {1.0f, 0.0f}, Standing(start));
+    Check(Near(out.yaw, 0.0f, 0.02f), "pushing sideways without moving turns nothing");
+}
+
+static void Pitch() {
+    const Vec hero{0.0f, -1.0f, -3.0f};
+    Rig rig;
+    rig.Run(2.0, {}, {}, Standing(hero));
+    const float resting = Out(rig.camera);
+    rig.Run(0.4, {0.0f, -1.0f}, {}, Standing(hero)); // stick down: from higher up
+    rig.Run(0.3, {}, {}, Standing(hero));             // the stick's own smoothing settles
+    const float high = Out(rig.camera);
+    Check(high > resting + 0.1f, "looking down from higher up, it sits further out");
+    Check(Near(high, Belongs(rig.camera), 0.05f), "at the distance that pitch calls for");
+    const float raised = rig.camera.Last().pitch;
+    rig.Run(3.0, {}, {}, Standing(hero));
+    Check(Near(rig.camera.Last().pitch, raised, 0.02f), "left alone with the hero standing, it keeps its pitch");
+    const double from = rig.now;
+    rig.Run(4.0, {}, {0.0f, 1.0f}, [&](double t) {
+        return std::optional<Vec>{Vec{hero.x, hero.y, hero.z - static_cast<float>(t - from)}};
+    });
+    const FlatCamera::Settings settings;
+    Check(Near(-rig.camera.Last().pitch, settings.rest_pitch, 0.08f), "as the hero moves on, it rests back");
+}
+
+static void Walls() {
+    const Vec hero{0.0f, -1.0f, -3.0f};
+    Rig rig;
+    // (Without the open's extra distance: taking the wall away would open the space too.)
+    FlatCamera::Settings no_open_extra;
+    no_open_extra.open_radius_extra = 0.0f;
+    rig.camera = FlatCamera{no_open_extra};
+    rig.Run(2.0, {}, {}, Standing(hero));
+    const float open = rig.camera.Last().position.z;
+    rig.level.wall = hero.z + 0.3f;
+    rig.Run(0.05, {}, {}, Standing(hero));
+    Check(rig.camera.Last().position.z < *rig.level.wall, "a wall behind it pulls it in at once");
+    rig.level.wall = hero.z + 0.01f;
+    rig.Run(0.05, {}, {}, Standing(hero));
+    Check(Out(rig.camera) >= FlatCamera::NearestOut - 1e-3f, "a wall right behind the hero pulls it no closer than its nearest");
+    rig.level.wall.reset();
+    rig.Run(2.0, {}, {}, Standing(hero));
+    Check(rig.camera.Last().position.z < hero.z + 0.35f, "the wall gone, it does not move out by itself");
+    rig.Run(3.0, {}, {0.0f, 1.0f}, Standing(hero));
+    Check(Near(rig.camera.Last().position.z, open, 0.05f), "played on, it lets out to its distance");
+}
+
+static void Ground() {
+    // A jump does not move the camera's height much; standing higher up does.
+    const Vec hero{0.0f, -1.0f, -3.0f};
+    Rig rig;
+    rig.Run(2.0, {}, {}, Standing(hero));
+    const float level = rig.camera.Last().position.y;
+    const double from = rig.now;
+    float highest = level;
+    for (int i = 0; i < 50; ++i) {
+        const auto out = rig.Run(0.01, {}, {}, [&](double t) {
+            const float u = static_cast<float>(t - from) / 0.5f;
+            return std::optional<Vec>{Vec{hero.x, hero.y + 0.3f * std::sin(Pi * std::min(u, 1.0f)), hero.z}};
+        });
+        highest = std::max(highest, out.position.y);
+    }
+    Check(highest - level < 0.1f, "a jump barely lifts the camera (" + std::to_string(highest - level) + " m)");
+    rig.level.floor = 0.0f; // stepped up, playing on
+    rig.Run(3.0, {}, {0.0f, 1.0f}, Standing({hero.x, 0.0f, hero.z}));
+    Check(rig.camera.Last().position.y > level + 0.8f, "on higher ground, it rises with the hero");
+}
+
+static void NoFloorFound() {
+    // With no floor in reach, a hero standing (stirring by a hair) after a drop does not jump the
+    // camera's height: it eases from where it is, not from a height left over from before.
+    Rig rig;
+    rig.level.floor = -1000.0f;
+    rig.Run(2.0, {}, {}, Standing({0.0f, 0.0f, -3.0f}));
+    rig.Run(2.0, {}, {}, Standing({0.0f, -1.0f, -3.0f}));
+    float previous = rig.camera.Last().position.y;
+    float largest = 0.0f;
+    for (int i = 0; i < 500; ++i) {
+        const float stir = (i / 3) % 2 == 0 ? 0.002f : -0.002f;
+        const float y = rig.Run(1.0 / Rate, {}, {}, Standing({0.0f, -1.0f + stir, -3.0f})).position.y;
+        largest = std::max(largest, std::abs(y - previous));
+        previous = y;
+    }
+    Check(largest < 0.005f, "no floor found, a hero standing still does not jump the camera (" +
+                                std::to_string(largest) + " m an update)");
+}
+
+static void MenuOverHero() {
+    // A menu room keeps its fixed view even while a hero seems to be there (a stale one).
+    const Vec hero{0.0f, -1.0f, -3.0f};
+    FlatCamera camera;
+    FlatCamera::Head out;
+    for (double now = 0.0; now < 3.0; now += 1.0 / Rate) {
+        out = camera.Update(now, {1.0f, 0.0f}, {}, hero, {}, {.fixed = true});
+    }
+    Check(Near(out.yaw, 0.0f, 0.01f) && Near(out.position.z, 0.0f, 0.01f), "a menu stays fixed even with a hero seen");
+}
+
+static void Menus() {
+    // A menu not to be turned: it faces ahead whatever the stick; with headings, a press right
+    // or left steps to the next one, holding it steps no further, and home turns back ahead.
+    FlatCamera camera;
+    double now = 0.0;
+    const auto run = [&](double seconds, Stick look, FlatCamera::Menu menu) {
+        FlatCamera::Head out = camera.Last();
+        for (double end = now + seconds; now < end;) {
+            now += 1.0 / Rate;
+            out = camera.Update(now, look, {}, std::nullopt, {}, menu);
+        }
+        return out;
+    };
+    auto out = run(2.0, {1.0f, 0.5f}, {.fixed = true});
+    Check(Near(out.yaw, 0.0f, 0.01f) && Near(out.pitch, 0.0f, 0.01f), "a fixed menu faces ahead whatever the stick");
+    const std::vector<Input::MenuStep> steps{{-1.2f, 0.0f}, {0.0f, 0.0f}, {1.2f, 0.3f}};
+    out = run(2.0, {1.0f, 0.0f}, {.fixed = true, .steps = steps});
+    Check(Near(out.yaw, 0.0f, 0.01f), "with headings it starts at the nearest; the stick steps nothing");
+    out = run(4.0, {}, {.fixed = true, .steps = steps, .step = 1});
+    Check(Near(out.yaw, -1.2f, 0.01f), "a press right steps one heading right, held it steps no further");
+    run(0.2, {}, {.fixed = true, .steps = steps});
+    run(0.2, {}, {.fixed = true, .steps = steps, .step = -1});
+    run(0.2, {}, {.fixed = true, .steps = steps});
+    out = run(4.0, {}, {.fixed = true, .steps = steps, .step = -1});
+    Check(Near(out.yaw, 1.2f, 0.01f) && Near(out.pitch, 0.3f, 0.01f), "two presses left: the step that looks up");
+    out = run(4.0, {}, {.fixed = true, .steps = steps, .home = true});
+    Check(Near(out.yaw, 0.0f, 0.01f), "home turns it back ahead");
+}
+
+static void SceneChanges() {
+    const Vec hero{0.0f, -1.0f, -3.0f};
+    Rig rig;
+    // Something that looks like a hero for a moment while a scene changes over.
+    auto out = rig.Run(FlatCamera::FollowAfter * 0.5, {}, {}, Standing(hero));
+    out = rig.Run(1.0, {}, {}, None);
+    Check(Near(out.position.x, 0.0f) && Near(out.position.y, 0.0f) && Near(out.position.z, 0.0f) &&
+              Near(out.yaw, 0.0f) && Near(out.pitch, 0.0f),
+          "a hero seen only for a moment is not followed: the camera stays at the seat");
+    rig.Run(2.0, {}, {}, Standing(hero));
+    const auto before = rig.camera.Last();
+    out = rig.Run(FlatCamera::LeaveAfter * 0.5, {}, {}, None);
+    Check(std::hypot(out.position.x - before.position.x, out.position.z - before.position.z) < 0.05f,
+          "a hero lost for a moment is still followed");
+}
+
+static void Configured() {
+    const Vec hero{0.0f, -1.0f, -3.0f};
+    Rig small;
+    small.level.floor = -10.0f;
+    small.Run(2.0, {}, {}, Standing(hero));
+    FlatCamera::Settings settings;
+    settings.scale = 2.0f;
+    Rig big{FlatCamera{settings}, 0.0, {}};
+    big.level.floor = -10.0f;
+    big.Run(2.0, {}, {}, Standing(hero));
+    Check(Near(Out(big.camera), Out(small.camera) * 2.0f, 0.03f),
+          "a title's hero twice the size: the camera twice as far out");
+}
+
+static void Zoom() {
+    FlatCamera::Settings settings;
+    settings.zoom = 1.6f;
+    Rig rig{FlatCamera{settings}, 0.0, {}};
+    const Vec hero{0.0f, -1.0f, -3.0f};
+    auto out = rig.Run(3.0, {}, {}, Standing(hero));
+    Check(out.zoom > 1.6f, "behind the hero the picture is enlarged, more the narrower the view");
+    out = rig.Run(3.0, {}, {}, None);
+    Check(Near(out.zoom, 1.0f, 0.01f), "with no hero (menus) it is shown as drawn");
+}
+
+static void BackToTheWorld() {
+    WorldPlacement placement;
+    placement.NotePose(0.0, {0.3f, 0.1f, -0.5f}, 0.4f);
+    placement.Update(1.0, {12.0f, 2.0f, -21.0f}, {-std::sin(1.0f), 0.0f, -std::cos(1.0f)}, 3.0f);
+    const Vec p{-1.0f, 0.5f, -2.0f};
+    const Vec back = placement.ToTrack(placement.ToWorld(p));
+    Check(Near(back.x, p.x) && Near(back.y, p.y) && Near(back.z, p.z), "tracking space to the world and back");
+}
+
+static void Placement() {
+    // A world 3 units to the metre, its origin at (10, 1, -20), turned 90 degrees left.
+    const float scale = 3.0f;
+    const Vec origin{10.0f, 1.0f, -20.0f};
+    const float turn = Pi / 2;
+    const auto to_world = [&](const Vec& track) {
+        const Vec t = WorldPlacement::Turn(track, turn);
+        return Vec{origin.x + t.x * scale, origin.y + t.y * scale, origin.z + t.z * scale};
+    };
+    const Vec pose{0.5f, 0.2f, -1.0f};
+    const float pose_yaw = 0.3f;
+    const Vec forward = WorldPlacement::Turn(Vec{-std::sin(pose_yaw), 0.0f, -std::cos(pose_yaw)}, turn);
+    WorldPlacement placement;
+    placement.NotePose(0.0, pose, pose_yaw);
+    placement.Update(1.0, to_world(pose), forward, scale);
+    const Vec hero{-2.0f, -1.0f, -4.0f};
+    const Vec back = placement.ToTrack(to_world(hero));
+    Check(Near(back.x, hero.x) && Near(back.y, hero.y) && Near(back.z, hero.z),
+          "a turned, moved, scaled world is placed back where it is");
+}
+
+static void LateTitle() {
+    // The title answers two of its frames late while the camera swings round fast and the title
+    // carries the seat along at a metre a second: what is followed must not seem to jump.
+    const float scale = 3.0f;
+    const double lag = WorldPlacement::TitleLag;
+    const auto origin_at = [&](double t) { return Vec{0.0f, 0.0f, static_cast<float>(-3.0 * t)}; };
+    const auto pose_at = [](double t) {
+        return Vec{static_cast<float>(1.5 * std::sin(2.0 * t)), 1.0f, static_cast<float>(1.5 * std::cos(2.0 * t))};
+    };
+    const auto yaw_at = [](double t) { return static_cast<float>(2.0 * t); };
+    const Vec hero_world{2.0f, 0.0f, -8.0f};
+    WorldPlacement placement;
+    float worst = 0.0f;
+    for (int i = 0; i < 1000; ++i) {
+        const double t = i / Rate;
+        placement.NotePose(t, pose_at(t), yaw_at(t));
+        if (t < lag) {
+            continue;
+        }
+        const double then = t - lag;
+        const Vec o = origin_at(then);
+        const Vec p = pose_at(then);
+        const Vec head{o.x + p.x * scale, o.y + p.y * scale, o.z + p.z * scale};
+        const float y = yaw_at(then);
+        placement.Update(t, head, Vec{-std::sin(y), 0.0f, -std::cos(y)}, scale);
+        if (t > 0.5) {
+            const Vec seen = placement.ToTrack(hero_world);
+            const Vec truth{(hero_world.x - o.x) / scale, (hero_world.y - o.y) / scale, (hero_world.z - o.z) / scale};
+            worst = std::max(worst, std::hypot(seen.x - truth.x, seen.y - truth.y, seen.z - truth.z));
+        }
+    }
+    Check(worst < 0.05f, "a title answering late, a camera swinging and a seat moving: the hero holds still (" +
+                             std::to_string(worst) + " m)");
+}
