+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <cstdlib>
+#include <imgui.h>
+
+#include "core/vr/flat_mode.h"
+#include "imgui/fade_picture_layer.h"
+#include "imgui/imgui_layer.h"
+#include "imgui/imgui_texture.h"
+
+namespace ImGui::FadePicture {
+namespace {
+
+/// The picture in the middle of the screen, as opaque as the picture under it is dark.
+class Layer final : public ImGui::Layer {
+public:
+    explicit Layer(const char* path) : picture{RefCountedTexture::DecodePngFile(path)} {
+        AddLayer(this);
+    }
+
+    void Draw() override {
+        const float dim = ::Core::Vr::PictureDim();
+        const auto image = picture.GetTexture();
+        if (dim <= 0.0f || image.im_id == nullptr) {
+            return;
+        }
+        static constexpr float ScreenShare = 1.0f / 3.0f; // of the screen's height, the picture's
+        const ImVec2 screen = GetIO().DisplaySize;
+        const float side = screen.y * ScreenShare;
+        const ImVec2 from{(screen.x - side) / 2, (screen.y - side) / 2};
+        GetForegroundDrawList()->AddImage(image.im_id, from, {from.x + side, from.y + side}, {0, 0}, {1, 1},
+                                          IM_COL32(255, 255, 255, static_cast<int>(255 * dim)));
+    }
+
+    // Drawn over the title's own frames only: no frames of its own (which would be the last one
+    // shown again each vblank, in the way of the title's).
+    bool ShouldKeepDrawing() override {
+        return false;
+    }
+
+private:
+    RefCountedTexture picture;
+};
+
+} // namespace
+
+void Start() {
+    static const char* const path = std::getenv("SHADPS4_VR_FLAT_FADE_PICTURE");
+    if (path != nullptr && path[0] != '\0') {
+        static Layer layer{path};
+    }
+}
+
+} // namespace ImGui::FadePicture
