-        DEPENDS Dear_ImGui_FontEmbed "fonts/${FONT_FILE}"
+        COMMAND ${IMGUI_FONT_EMBED_COMMAND} -nostatic "${CMAKE_CURRENT_SOURCE_DIR}/fonts/${FONT_FILE}" ${fontname_cpp} > "${OUTPUT}.g.cpp"
