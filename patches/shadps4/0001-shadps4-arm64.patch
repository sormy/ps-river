+    const s64 count = QueryOpActualCount(op);
+    LOG_INFO(Lib_SysModule, "[FIOS-HLE][OpGetError] op={} error={}", op, count < 0 ? count : 0);
+    return count < 0 ? static_cast<s32>(count) : 0;
+}
